{
 "d": "163",
 "title_de": "Sängers Morgenlied",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Süsses Licht,",
    "Aus goldenen Pforten brichst du,",
    "Siegend durch die Nacht.",
    "Schöner Tag, du bist erwacht!",
    "Mit geheimnissvollen Worten,",
    "In melodischen Accorden",
    "Grüss ich deine Rosenpracht,",
    "Grüss ich deine Rosenpracht."
   ]
  },
  {
   "lines_de": [
    "Ach! Der Liebe sanftes Wehen",
    "Schwellt mir das bewegte Herz,",
    "Sanft wie ein geliebter Schmerz.",
    "Dürft ich nur auf goldnen Höhen",
    "Mich im Morgenduft ergehen —",
    "Sehnsucht zieht mich himmelwärts,",
    "Sehnsucht zieht mich himmelwärts."
   ]
  }
 ],
 "poet_de": "Theodor Körner"
}