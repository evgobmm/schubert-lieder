{
 "d": "688/1",
 "title_de": "Non t'accostar all'Urna",
 "year": "1820",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Non t'accostar all'urna,",
    "Che l'osse mie rinserra.",
    "Questa pietosa terra",
    "è Sacra al mio dolor."
   ]
  },
  {
   "lines_de": [
    "Ricuso i tuoi giacinti",
    "Non voglio i tuoi pianti,",
    "Che giovan agli estinti",
    "Due lagrime, due fior?"
   ]
  },
  {
   "lines_de": [
    "Empia! dovevi allor",
    "Porgermi un fil d'aita,",
    "Quando traéa la vita",
    "In grembo dei sospir."
   ]
  },
  {
   "lines_de": [
    "Ah che d'inutil pianto",
    "Assordi la foresta?",
    "Rispetta un ombra mesta",
    "E lascia la dormir,",
    "Rispetta un ombra mesta",
    "E lascia la dormir."
   ]
  }
 ],
 "poet_de": "Pietro Metastasio, Jacopo Vittorelli"
}