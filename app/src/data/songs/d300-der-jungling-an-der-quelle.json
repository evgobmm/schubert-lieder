{
 "d": "300",
 "title_de": "Der Jüngling an der Quelle",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Leise, rieselnder Quell! Ihr wallenden, flispernden Pappeln,",
    "Euer Schlummergeräusch",
    "Wecket die Liebe nur auf.",
    "Linderung sucht' ich bei euch, Und sie zu vergessen, die Spröde;",
    "Ach, und Blätter und Bach",
    "Seufzen, Luise, mir zu!",
    "Ach, und Blätter und Bach",
    "Seufzen, Luise mir zu,",
    "Luise, Luise!"
   ]
  }
 ],
 "poet_de": "Johann Gaudenz von Salis-Seewis"
}