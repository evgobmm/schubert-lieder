{
 "d": "721",
 "title_de": "Mahomets Gesang",
 "year": "1821",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Seht den Felsenquell,",
    "Freudehell,",
    "Seht den Felsenquell,",
    "Freudehell,",
    "Wie ein Sternenblick,",
    "Wie ein Sternenblick",
    "Über Wolken",
    "Nährten seine Jugend",
    "Gute Geister",
    "Zwischen Klippen im Gebüsch.",
    "Seht, seht den Felsenquell!"
   ]
  },
  {
   "lines_de": [
    "Jünglingfrisch",
    "Tanzt er aus der Wolke",
    "Auf die Marmorfelsen nieder,",
    "Jauchzet wieder nach dem Himmel,",
    "Jauchzet wieder nach dem Himmel,",
    "Jünglingfrisch."
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}