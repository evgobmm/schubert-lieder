{
 "d": "507",
 "title_de": "Skolie",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Mädchen entsiegelten,",
    "Brüder, die Flaschen;",
    "Auf, die geflügelten",
    "Freuden zu haschen,",
    "Locken und Becher von Rosen umglüht!",
    "Locken und Becher von Rosen umglüht!",
    "Auf, eh die moosigen",
    "Hügel uns winken,",
    "Wonne von rosigen",
    "Lippen zu trinken!",
    "Huldigung allem, was jugendlich blüht,",
    "Huldigung allem, was jugendlich blüht!"
   ]
  }
 ],
 "poet_de": "Friedrich von Matthisson"
}