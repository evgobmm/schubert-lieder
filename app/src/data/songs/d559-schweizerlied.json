{
 "d": "559",
 "title_de": "Schweizerlied",
 "year": "1817",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Uf'm Bergli",
    "Bin i gsässe,",
    "Ha de Vögle",
    "Zugeschaut:",
    "Hänt gesunge,",
    "Hänt gesprunge,",
    "Hänt's Nästli",
    "Gebaut."
   ]
  },
  {
   "lines_de": [
    "In ä Garte",
    "Bin i gstande,",
    "Ha de Imbli",
    "Zugeschaut:",
    "Hänt gebrummet,",
    "Hänt gesummet,",
    "Hänt Zelli",
    "Gebaut."
   ]
  },
  {
   "lines_de": [
    "Uf Wiese",
    "Bin i Gange,",
    "Ha de Summer-",
    "Vögle zuge-schaut:",
    "Hänt gesoge,",
    "Hänt gefloge,",
    "Gar z' schön hänt's",
    "Gethan."
   ]
  },
  {
   "lines_de": [
    "Und da kummt nu",
    "Der Hansel,",
    "Und da zeig i",
    "Em froh,",
    "Wie sie's mache,",
    "Und mer lache,",
    "Und mache",
    "Au so."
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}