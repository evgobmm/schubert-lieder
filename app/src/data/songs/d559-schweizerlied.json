{
 "d": "559",
 "title_de": "Schweizerlied",
 "year": "1817",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Uf'm Bergli bin i gsässe,",
    "ha de Vögle zuge-",
    "schaut: hänt gesunge, hänt gesprunge,",
    "hänt's Nästli gebaut."
   ]
  },
  {
   "lines_de": [
    "In ä Garte bin i gstande,",
    "ha de Imbli zuge-",
    "schaut: hänt gebrummet, hänt gesummet,",
    "hänt Zelli gebaut."
   ]
  },
  {
   "lines_de": [
    "Uf Wiese bin i gange,",
    "ha de Summer-",
    "Vögle zuge-schaut: hänt gesoge, hänt gefloge,",
    "Gar z' schön hänt's gethan."
   ]
  },
  {
   "lines_de": [
    "Und da kummt nu der Hansel,",
    "Und da zeig i em froh,",
    "Wie sie's mache, und mer lache,",
    "Und mache au so."
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}