{
 "d": "889",
 "title_de": "Ständchen",
 "year": "1826",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Horch, horch! die Lerch’ im Ätherblau;",
    "und Phöbus, neu erweckt,",
    "tränkt seine Rosse mit dem Tau,",
    "der Blumenkelche deckt,",
    "der Blumenkelche deckt;"
   ]
  },
  {
   "lines_de": [
    "der Ringelblumen Knospe schleusst",
    "die goldnen Äuglein auf;",
    "mit allem, was da reizend heisst,",
    "du süsse Maid steh auf,",
    "mit allem, was da reizend heisst,",
    "du süsse Maid steh auf,"
   ]
  },
  {
   "lines_de": [
    "steh auf, steh auf,",
    "du süsse Maid steh auf,",
    "steh auf, steh auf,",
    "du süsse Maid steh auf!"
   ]
  }
 ],
 "poet_de": "William Shakespeare, Abraham Voß"
}