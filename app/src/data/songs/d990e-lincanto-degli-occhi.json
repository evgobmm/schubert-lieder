{
 "d": "990E",
 "title_de": "L'incanto degli occhi",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Da voi, cari lumi,",
    "Dipende il mio stato,",
    "Voi siete i miei Numi,",
    "Voi siete il mio fato,",
    "Vostro talento mi sento cangiar,",
    "Vostro talento",
    "Mi sento cangiar."
   ]
  },
  {
   "lines_de": [
    "Nur Euch, schöne Sterne, gehört all mein Leben,",
    "Wie Götter so ferne beseelt ihr mein Streben,",
    "Nach eurem Winke bewegt sich mein Sinn,",
    "Nach eurem Winke bewegt sich mein Sinn."
   ]
  },
  {
   "lines_de": [
    "Se lieti splendete,",
    "Se torbidi siete,",
    "Mi fate — tremar."
   ]
  }
 ],
 "poet_de": "Pietro Metastasio"
}