{
 "d": "381",
 "title_de": "Morgenlied",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Die frohe, neubelebte Flur",
    "singt ihrem Schöpfer Dank,",
    "der Lebensfreuden schenkst du viel",
    "dem, der sich weislich freut.",
    "Herr und Vater der Natur,",
    "dir tönt auch mein Gesang,",
    "sei, Vater, stets das Ziel",
    "bei meiner Fröhlichkeit.",
    "Herr und Vater der Natur,",
    "dir tönt auch mein Gesang,",
    "sei, Vater, stets das Ziel",
    "bei meiner Fröhlichkeit."
   ]
  },
  {
   "lines_de": [
    "Ich kann mich noch des Lebens freu'n",
    "in dieser schönen Welt.",
    "Mein Herz soll dem geheiligt sein,",
    "der weislich sie erhält.",
    "Mein Herz soll dem geheiligt sein,",
    "der weislich sie erhält."
   ]
  },
  {
   "lines_de": [
    "Wenn dann mir Müden winkt der Tod",
    "zur bessern Welt zu geh'n,",
    "so bricht ein schönres Morgenroth",
    "mir an beim Aufersteh'n.",
    "So bricht ein schönres Morgenroth",
    "mir an beim Aufersteh'n."
   ]
  }
 ],
 "poet_de": "Johann Christoph Heise"
}