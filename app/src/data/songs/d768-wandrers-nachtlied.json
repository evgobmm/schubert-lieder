 "title_de": "Wandrers Nachtlied",
 "year": "1824",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Über allen Gipfeln",
    "ist Ruh’,",
    "in allen Wipfeln",
    "spürest du",
    "kaum einen Hauch;",
    "die Vöglein schweigen, schweigen im Walde."
   ]
  },
  {
   "lines_de": [
    "Warte nur, warte nur, balde",
    "ruhest du auch,",
    "warte nur, warte nur balde",
    "ruhest du auch."
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}