{
 "d": "891",
 "title_de": "An Silvia",
 "year": "1826",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Was ist Sylvia, saget an,",
    "Dass sie die weite Flur preist?",
    "Schön und zart seh ich sie nahn,",
    "Auf Himmels Gunst und Spur weist,",
    "Dass ihr Alles unterthan."
   ]
  },
  {
   "lines_de": [
    "Ist sie schön und gut dazu?",
    "Reiz labt wie milde Kindheit;",
    "Ihrem Aug' eilt Amor zu,",
    "Dort heilt er seine Blindheit,",
    "Und verweilt in süsser Ruh'."
   ]
  },
  {
   "lines_de": [
    "Darum Sylvia, tön, o Sang,",
    "Der holden Sylvia Ehren;",
    "Jeden Reiz besiegt sie lang,",
    "Den Erde kann gewähren:",
    "Kränze ihr und Saitenklang!"
   ]
  }
 ],
 "poet_de": "William Shakespeare, Eduard von Bauernfeld"
}