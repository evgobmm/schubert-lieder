{
 "d": "369",
 "title_de": "An Schwager Kronos",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Spute dich, Kronos!",
    "Fort den rasselnden Trott!",
    "Bergab gleitet der Weg,",
    "Bergab gleitet der Weg;",
    "Ekles Schwindeln zögert",
    "Mir vor die Stirne dein Zaudern.",
    "Frisch, holpert es gleich",
    "Über Stock und Steine den Trott,",
    "Rasch in's Leben hinein,",
    "Rasch in's Leben hinein!"
   ]
  },
  {
   "lines_de": [
    "Nun schon wieder,",
    "Nun schon wieder",
    "Den erathmenden Schritt",
    "Mühsam Berg hinauf.",
    "Auf denn, nicht träge denn,",
    "Strebend und hoffend hinan!"
   ]
  },
  {
   "lines_de": [
    "Weit, hoch, herrlich rings",
    "Den Blick in's Leben hinein,",
    "Vom Gebirg zum Gebirg",
    "Schwebet der ewige Geist,",
    "Ewigen Lebens ahndevoll."
   ]
  },
  {
   "lines_de": [
    "Seitwärts des Überdachs Schatten",
    "Zieht dich an,",
    "Zieht dich an,",
    "Und ein Frischung verheissender Blick",
    "Auf der Schwelle des Mädchens da.",
    "Labe dich!",
    "Labe dich!",
    "Mir auch, Mädchen,",
    "Diesen schäumenden Trank,",
    "Diesen frischen Gesundheitsblick!"
   ]
  },
  {
   "lines_de": [
    "Ab denn, rascher hinab!",
    "Sieh, die Sonne sinkt!",
    "Eh sie sinkt, eh mich Greisen",
    "Ergreift im Moore Nebelduft,",
    "Entzahnte Kiefer schnattern",
    "Und das schlotternde Gebein, —"
   ]
  },
  {
   "lines_de": [
    "Trunken vom letzten Strahl",
    "Reiss mich, ein Feuermeer",
    "Mir im schäumenden Aug,",
    "Mich geblendeten Taumelnden",
    "In der Hölle nächtliches Thor!"
   ]
  },
  {
   "lines_de": [
    "Töne, Schwager, in's Horn,",
    "Rassle den schallenden Trab,",
    "Töne, Schwager, in's Horn,",
    "Rassle den schallenden Trab,",
    "Dass der Orkus vernehme: wir kommen,",
    "Dass gleich an der Thür",
    "Der Wirth uns freundlich empfange."
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}