{
 "d": "434",
 "title_de": "Erntelied",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Sicheln schallen, Ähren fallen unter Sichelschall,",
    "Sicheln klingen, Mädchen singen unter Sichelklang,",
    "Auf den Mädchenhüten zittern blaue Blüthen, Freud ist überall,",
    "Bis vom Mond beschimmert rings die Stoppel flimmert, tönt der Erntesang."
   ]
  },
  {
   "lines_de": [
    "Alles springet, Alles singet,",
    "Was nur lallen kann;"
   ]
  },
  {
   "lines_de": [
    "Hans und Michel schärft die Sichel,",
    "Pfeift ein Lied dazu."
   ]
  },
  {
   "lines_de": [
    "Bei dem Erntemahle",
    "Isst aus einer Schale",
    "Knecht und Bauersmann;"
   ]
  },
  {
   "lines_de": [
    "Mähet dann beginnen",
    "Schnell die Binderinnen,",
    "Binden sonder Ruh."
   ]
  },
  {
   "lines_de": [
    "Jeder scherzet, Jeder herzet",
    "Dann sein Liebelein;",
    "Nach geleerten Kannen",
    "Gehen sie von dannen,",
    "Singen und juchhein."
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
}