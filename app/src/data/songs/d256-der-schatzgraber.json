{
 "d": "256",
 "title_de": "Der Schatzgräber",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Arm am Beutel, krank am Herzen,",
    "Schleppt' ich meine langen Tage.",
    "Armuth ist die grösste Plage,",
    "Reichthum ist das höchste Gut!",
    "Und zu enden meine Schmerzen,",
    "Ging ich einen Schatz zu graben.",
    "Meine Seele sollst du haben!",
    "Schrieb ich hin mit eignem Blut,",
    "Schrieb ich hin mit eigenem Blut."
   ]
  },
  {
   "lines_de": [
    "Und so zog ich Kreis um Kreise,",
    "Stellte wunderbare Flammen,",
    "Kraut und Knochenwerk zusammen:",
    "Die Beschwörung war vollbracht.",
    "Und auf die gelernte Weise",
    "Grub ich nach dem alten Schatze",
    "Auf dem angezeigten Platze:",
    "Schwarz und stürmisch war die Nacht,",
    "War die Nacht."
   ]
  },
  {
   "lines_de": [
    "Und ich sah ein Licht, ein Licht von weiten,",
    "Und es kam gleich einem Sterne",
    "Hinten aus der fernsten Ferne,",
    "Eben als es zwölfe schlug.",
    "Und da galt kein Vorbereiten;",
    "Heller ward's mit einem male",
    "Von dem Glanz der vollen Schale,",
    "Die ein schöner Knabe trug,",
    "Die ein schöner Knabe trug."
   ]
  },
  {
   "lines_de": [
    "Holde Augen sah ich blinken",
    "Unter dichtem Blumenkranze;",
    "In des Trankes Himmelsglanze",
    "Trat er in den Kreis herein.",
    "Und er hiess mich freundlich trinken;",
    "Und ich dacht': es kann der Knabe",
    "Mit der schönen lichten Gabe",
    "Wahrlich nicht der Böse sein,",
    "Wahrlich nicht der Böse sein."
   ]
  },
  {
   "lines_de": [
    "Trinke Muth des reinen Lebens!",
    "Dann verstehst du die Belehrung,",
    "Kommst mit ängstlicher Beschwörung",
    "Nicht zurück an diesen Ort.",
    "Grabe hier nicht mehr vergebens:",
    "Tages Arbeit! Abends Gäste!",
    "Saure Wochen! Frohe Feste!",
    "Sei dein künftig Zauberwort,",
    "Sei dein künftig Zauberwort zum Schlusse."
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}