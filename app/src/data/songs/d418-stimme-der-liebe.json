{
 "d": "418",
 "title_de": "Stimme der Liebe",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Abendgewölke schweben hell",
    "Am bepurpurten Himmel;",
    "Hesperus schaut mit Liebesblick",
    "Durch den blühenden Lindenhain,",
    "Und sein prophetisches Trauerlied",
    "Zirpt im Kraute das Heimchen:",
    "Mir tönt Stimme der Liebe!"
   ]
  },
  {
   "lines_de": [
    "Aus der Platanen Labyrinth wandelt Laura — die Freuden der Liebe harren dein!",
    "Flüstern leise die Winde — die",
    "Freuden der Liebe harren dein!",
    "Tönt die Kehle der Nachtigall,",
    "Hoch von dem Sternengewölb herab",
    "Hallt mir Stimme der Liebe!"
   ]
  },
  {
   "lines_de": [
    "Aus der Platanen Labyrinth",
    "Wandelt Laura, die Holde!",
    "Holde Blumen entspriessen dem Zephyrtritt,",
    "Und wie",
    "Hoch von dem Sternengewölb herab hallt Sphärengesangeston,",
    "Bebt von den Rosen der Lippe mir",
    "Süsse Stimme der Liebe."
   ]
  }
 ],
 "poet_de": "Friedrich von Matthisson"
}