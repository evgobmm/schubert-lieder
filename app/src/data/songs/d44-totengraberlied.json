 "title_de": "Totengräberlied",
 "year": "1813",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Grabe, Spaten, grabe!",
    "Alles, was ich habe,",
    "Dank' ich, Spaten, dir!",
    "Reich und arme Leute",
    "Werden meine Beute,",
    "Kommen einst zu mir."
   ]
  },
  {
   "lines_de": [
    "Weiland groß und edel",
    "Nickte dieser Schädel",
    "Keinem Grusse Dank;",
    "Dieses Beingerippe",
    "Ohne Wang und Lippe",
    "Hatte Gold und Rang,",
    "Hatte Gold und Rang."
   ]
  },
  {
   "lines_de": [
    "Jener Kopf mit Haaren",
    "War vor wenig Jahren",
    "Schön wie Engel sind;",
    "Tausend junge Fäntchen",
    "Leckten ihm das Händchen,",
    "Gafften sich halb blind."
   ]
  },
  {
   "lines_de": [
    "Grabe, Spaten, grabe!",
    "Alles, was ich habe,",
    "Dank' ich, Spaten, dir!",
    "Reich und arme Leute",
    "Werden meine Beute,",
    "Kommen einst zu mir."
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
