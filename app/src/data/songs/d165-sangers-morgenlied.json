{
 "d": "165",
 "title_de": "Sängers Morgenlied",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Süsses Licht! Aus goldnen Pforten",
    "Brichst du siegend durch die Nacht,",
    "Schöner Tag, du bist erwacht!",
    "Mit geheimnissvollen Worten,",
    "In melodischen Accorden",
    "Grüss ich deine Rosenpracht, grüss ich deine Rosenpracht."
   ]
  },
  {
   "lines_de": [
    "Ach, der Liebe sanftes Wehen",
    "Schwellt mir das bewegte Herz,",
    "Sanft wie ein geliebter Schmerz,",
    "Dürft ich nur auf goldnen Höhen",
    "Mich im Morgenduft ergehen,",
    "Sehnsucht zieht mich himmelwärts, Sehnsucht zieht mich himmelwärts."
   ]
  },
  {
   "lines_de": [
    "Und der Seele kühnes Streben",
    "Trägt im stolzen Riesenlauf",
    "Durch die Wolken mich hinauf;",
    "Doch mit sanftem Geisterbeben",
    "Dringt das Lied ins inn're Leben,",
    "Löst den Sturm melodisch auf, löst den Sturm melodisch auf."
   ]
  },
  {
   "lines_de": [
    "Vor den Augen wird es helle,",
    "Freundlich auf der zarten Spur",
    "Weht der Einklang der Natur,",
    "Und begeistert rauscht die Quelle,",
    "Munter tanzt die flüchtige Welle",
    "Durch des Morgens stille Flur, durch des Morgens stille Flur."
   ]
  },
  {
   "lines_de": [
    "Und von süsser Lust durchdrungen",
    "Webt sich zarte Harmonie",
    "Durch des Lebens Poesie;",
    "Was die Seele tief durchklungen,",
    "Was berauscht der Mund gesungen,",
    "Glüht in hoher Melodie, glüht in hoher Melodie."
   ]
  },
  {
   "lines_de": [
    "Des Gesanges muntern Söhnen",
    "Weicht im Leben jeder Schmerz,",
    "Und nur Liebe schwellt ihr Herz;",
    "In des Liedes heilgen Tönen,",
    "Und im Morgenglanz des Schönen",
    "Fliegt die Seele himmelwärts, fliegt die Seele himmelwärts."
   ]
  }
 ],
 "poet_de": "Theodor Körner"
}