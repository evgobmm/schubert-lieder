{
 "d": "535",
 "title_de": "Lied (Brüder, schrecklich brennt die Träne)",
 "year": "1817",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Brüder, schrecklich brennt die Thräne,",
    "Die verschämte Armuth weint;",
    "Findet diese Jammerscene",
    "Unter uns wohl keinen Freund?"
   ]
  },
  {
   "lines_de": [
    "Der Verzweiflung preisgegeben",
    "Ringt die welken Hände sie;",
    "Kommt, erleichtert heut' ihr Leben",
    "Durch des Mitleids Sympathie."
   ]
  }
 ],
 "poet_de": "unbekannt"
}