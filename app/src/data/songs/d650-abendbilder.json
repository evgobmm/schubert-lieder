{
 "d": "650",
 "title_de": "Abendbilder",
 "year": "1819",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Still beginnt's im Hain zu thauen,",
    "ruhig webt der Dämmrung Grauen",
    "durch die Gluth sanfter Fluth,",
    "durch das Grün umbuschter Auen,",
    "so die trunknen Blicke schauen,",
    "so die trunknen Blicke schauen."
   ]
  },
  {
   "lines_de": [
    "Sieh, der Raben Nachtgefieder",
    "rauscht auf ferne Eichen nieder,",
    "Balsamduft haucht die Luft,",
    "Philomelens Zauberlieder",
    "hallet zart die Echo wieder,",
    "wieder hallet, hallet zart die Echo wieder."
   ]
  },
  {
   "lines_de": [
    "Horch, des Abendglöckleins Töne",
    "mahnen ernst der Erde Söhne,",
    "dass ihr Herz himmelwärts,",
    "sinnend ob der Heimath Schöne,",
    "sich des Erdentand's entwöhne."
   ]
  },
  {
   "lines_de": [
    "Durch der hohen Wolken Riegel",
    "funkeln tausend Himmelssiegel,",
    "Luna's Bild streuet mild",
    "in der Fluthen klarem Spiegel,",
    "schimmernd Gold auf Flur und Hügel,",
    "schimmernd Gold auf Flur und Hügel."
   ]
  },
  {
   "lines_de": [
    "Von des Vollmond's Wiederscheine,",
    "von des Vollmond's Wiederscheine,",
    "blitzet das bemooste kleine",
    "Kirchendach; aber ach!",
    "rings umdecken Leichensteine",
    "der Entschlummerten Gebein."
   ]
  },
  {
   "lines_de": [
    "Ruht, Traute, von den Wehen,",
    "bis beim grossen Auferstehen",
    "aus der Nacht Gottes Macht",
    "einst uns ruft in seiner Höhen",
    "ewge Wonnen einzugehen.",
    "Ruht, Traute, von den Wehen,",
    "bis beim grossen Auferstehn,",
    "Gottes Macht einst uns ruft",
    "in seiner Höhen ewge Wonnen",
    "einzugehen, in seiner Höhen",
    "ewge Wonnen einzugehen."
   ]
  }
 ],
 "poet_de": "Johann Peter Silbert"
}