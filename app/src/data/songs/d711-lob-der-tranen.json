{
 "d": "711",
 "title_de": "Lob der Tränen",
 "year": "1818",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Laue Lüfte,",
    "Blumendüfte,",
    "Alle Lenz- und Jugendlust,",
    "Frischer Lippen",
    "Küsse nippen,",
    "Sanft gewiegt an zarter Brust,",
    "Dann der Trauben",
    "Nektar rauben,",
    "Reihentanz und Spiel und Scherz,",
    "Was die Sinne",
    "Nur gewinnen,",
    "Ach erfüllt es je das Herz?",
    "Ach erfüllt es je das Herz?"
   ]
  },
  {
   "lines_de": [
    "Wenn die feuchten",
    "Augen leuchten",
    "Von der Wehmuth lindem Thau,",
    "Dann entsiegelt,",
    "Drin gespiegelt",
    "Sich dem Blick die Himmelsau,",
    "Wie erquicklich,",
    "Augenblicklich",
    "Löscht es jede wilde Gluth,",
    "Wie vom Regen",
    "Blumen pflegen,",
    "Hebet sich der matte Muth.",
    "Hebet sich der matte Muth."
   ]
  },
  {
   "lines_de": [
    "Nicht mit süssen",
    "Wasserflüssen",
    "Zwang Prometheus unsern Leim,",
    "Nein, mit Thränen,",
    "Drum im Sehnen",
    "Und im Schmerz sind wir daheim,",
    "Bitter schwellen",
    "Diese Quellen",
    "Für den erdumfang'nen Sinn,",
    "Doch sie drängen",
    "Aus den Engen",
    "In das Meer der Liebe hin."
   ]
  },
  {
   "lines_de": [
    "Ewges Sehnen",
    "Floss in Thränen",
    "Und umgab die starre Welt,",
    "Die in Armen,",
    "Sein Erbarmen",
    "Immerdar umfluthend hält,",
    "Soll dein Wesen",
    "Denn genesen,",
    "Von dem Erdenstaube los,",
    "Musst im Weinen",
    "Dich vereinen",
    "Jener Wasser heilgem Schooss."
   ]
  }
 ],
 "poet_de": "August Wilhelm von Schlegel"
}