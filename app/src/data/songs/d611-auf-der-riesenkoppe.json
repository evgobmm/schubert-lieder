{
 "d": "611",
 "title_de": "Auf der Riesenkoppe",
 "year": "1818",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Hoch auf dem Gipfel",
    "Deiner Gebirge",
    "Steh ich",
    "Und staun ich,",
    "Glühend begeistert,",
    "Heilige Koppe,",
    "Himmelsanstürmerin!"
   ]
  },
  {
   "lines_de": [
    "Weit in die Ferne",
    "Schweifen die trunknen,",
    "Freudigen Blicke,",
    "Und überall Leben,",
    "Üppiges Streben überall,",
    "Sonnenschein."
   ]
  },
  {
   "lines_de": [
    "Blühende Fluren,",
    "Schimmernde Städte",
    "Dreier Königreiche",
    "Glückliche Länder",
    "Schau ich begeistert,",
    "Schau ich mit hoher,",
    "Mit inniger Lust."
   ]
  },
  {
   "lines_de": [
    "Auch meines Vaterlands",
    "Grenze erblick ich,",
    "Wo mich das Leben",
    "Freundlich begrüsste,",
    "Wo mich der Liebe",
    "Heilige Sehnsucht",
    "Glühend ergriff."
   ]
  },
  {
   "lines_de": [
    "Sei mir gesegnet hier in der Ferne, liebliche Heimath,"
   ]
  },
  {
   "lines_de": [
    "Sei mir gesegnet",
    "Hier in der Ferne,",
    "Liebliche Heimath!",
    "Sei mir gesegnet,",
    "Land meiner Träume,",
    "Kreis meiner Lieben, sei mir gegrüsst,",
    "Kreis meiner Lieben,",
    "Sei mir gegrüsst!"
   ]
  }
 ],
 "poet_de": "Theodor Körner"
}