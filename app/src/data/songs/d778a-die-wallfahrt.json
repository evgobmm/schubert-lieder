{
 "d": "778A",
 "title_de": "Die Wallfahrt",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Meine Thränen im Bussgewand",
    "die Wallfahrt haben",
    "zur Kaaba der Schönheit angetreten.",
    "In der Wüste brennendem Sand",
    "sind sie begraben,",
    "nicht hingelangten sie anzubeten."
   ]
  }
 ],
 "poet_de": "Friedrich Rückert"
}