{
 "d": "342",
 "title_de": "An mein Klavier",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Sanftes Clavier, sanftes Clavier, welche Entzückungen",
    "Schaffest du mir, sanftes Clavier, sanftes Clavier,",
    "Sanftes Clavier!",
    "Bin ich allein, bin ich allein, hauch ich dir meine Empfindungen ein,",
    "Himmlisch und rein, himmlisch und rein."
   ]
  },
  {
   "lines_de": [
    "Wenn sich die Schönen tändelnd verwöhnen,",
    "Unschuld im Spiele, Tugendgefühle",
    "Weih ich mich dir, liebes Clavier, weih ich mich dir, liebes Clavier,",
    "Sprechen aus dir, trautes Clavier, sprechen aus dir, trautes Clavier."
   ]
  },
  {
   "lines_de": [
    "Trautes Clavier!",
    "Sing ich dazu, sanftes Clavier,",
    "Goldener Flügel, welch himmlische Ruh,",
    "Welche Entzückungen schaffest du mir,",
    "Lispelst mir du, goldnes Clavier."
   ]
  },
  {
   "lines_de": [
    "Thränen der Freude, wenn mich im Leben",
    "Netzen die Saite, Sorgen umschweben,",
    "Silberner Klang, töne du mir,",
    "Silberner Klang",
    "Trägt den Gesang, trautes Clavier."
   ]
  },
  {
   "lines_de": [
    "Goldnes Clavier!",
    "Wenn mich im Leben",
    "Sorgen umschweben,",
    "Töne du mir,"
   ]
  },
  {
   "lines_de": [
    "Sing' ich dazu,",
    "Lispelst mir du!",
    "Thränen der Freude",
    "Netzen die Saite!",
    "Trägt den Gesang."
   ]
  }
 ],
 "poet_de": "Christian Friedrich Daniel Schubart"
}