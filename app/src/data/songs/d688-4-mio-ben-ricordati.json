{
 "d": "688/4",
 "title_de": "Mio ben, ricordati",
 "year": "1820",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Mio ben, ricordati,",
    "S'avvien ch'io mora,",
    "Quanto quest'anima",
    "Fedel t'amò."
   ]
  },
  {
   "lines_de": [
    "E se pur amano",
    "Le fredde ceneri,",
    "Nell'urna ancora",
    "T'adorerò."
   ]
  }
 ],
 "poet_de": "Pietro Metastasio, Jacopo Vittorelli"
}