{
 "d": "688/4",
 "title_de": "Mio ben, ricordati",
 "year": "1820",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Mio ben, ricordati,",
    "s'avvien ch'io mora,",
    "quanto quest'anima",
    "fedel t'amò."
   ]
  },
  {
   "lines_de": [
    "E se pur amano",
    "le fredde ceneri,",
    "nell'urna ancora",
    "t'adorerò."
   ]
  }
 ],
 "poet_de": "Pietro Metastasio, Jacopo Vittorelli"
}