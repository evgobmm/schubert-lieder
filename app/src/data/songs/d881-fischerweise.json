  {
   "lines_de": [
    "Da lagert rings noch Friede",
    "auf Wald und Flur und Bach,",
    "er ruft mit seinem Liede",
    "die gold'ne Sonne wach,",
    "er ruft mit seinem Liede",
    "die gold'ne Sonne wach."
   ]
  },
