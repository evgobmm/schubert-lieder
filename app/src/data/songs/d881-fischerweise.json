   "lines_de": [
    "Den Fischer fechten Sorgen",
    "und Gram und Leid nicht an;",
    "Er löst am frühen Morgen",
    "mit leichtem Sinn den Kahn,",
    "mit leichtem Sinn den Kahn."
   ]
