{
 "d": "854",
 "title_de": "Fülle der Liebe",
 "year": "1825",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Ein sehnend Streben",
    "Theilt mir das Herz,",
    "Bis alles",
    "Leben sich löst"
   ]
  },
  {
   "lines_de": [
    "In Schmerz.",
    "In Leiden wachte der junge Sinn,",
    "Und Liebe brachte",
    "Zum Ziel mich hin."
   ]
  },
  {
   "lines_de": [
    "Ihr edle Flammen,",
    "Wecktet mich auf,",
    "Es ging mit sammen zu Gott der Lauf,",
    "Es ging mit",
    "Sammen zu Gott der Lauf."
   ]
  },
  {
   "lines_de": [
    "Ein Feuer war es,",
    "Das alles treibt,",
    "Ein starkes, klares,",
    "Das ewig bleibt."
   ]
  },
  {
   "lines_de": [
    "Was wir anstrebten,",
    "War treu gemeint,",
    "Was wir durchlebten,",
    "Bleibt tief vereint."
   ]
  },
  {
   "lines_de": [
    "Da trat ein Scheiden",
    "Mir in die Brust,",
    "Das tiefe Leiden",
    "Der Liebeslust."
   ]
  },
  {
   "lines_de": [
    "Im Seelengrunde",
    "Wohnt mir ein Bild,",
    "Die Todeswunde",
    "Ward nie gestillt."
   ]
  },
  {
   "lines_de": [
    "Viel tausend Thränen flossen",
    "Hin ab,",
    "Ein ewig Sehnen zu ihr in's Grab,",
    "Ein ewig Sehnen",
    "Zu ihr in's Grab."
   ]
  },
  {
   "lines_de": [
    "In Liebeswogen wallet",
    "Der Geist,",
    "Bis fortgezogen",
    "Die Brust zerreisst."
   ]
  },
  {
   "lines_de": [
    "Ein Stern erschien mir",
    "Vom Paradies,",
    "Und dahin flieh'n wir vereint gewiss,",
    "Und dahin flieh'n wir",
    "Vereint gewiss."
   ]
  },
  {
   "lines_de": [
    "Hier noch befeuchtet",
    "Der Blick sich lind,",
    "Wenn mich umleuchtet",
    "Dies Himmelskind."
   ]
  },
  {
   "lines_de": [
    "Ein Zauber waltet",
    "Jetzt über mich,",
    "Und der gestaltet",
    "Dies all nach sich,"
   ]
  },
  {
   "lines_de": [
    "Als ob uns vermähle",
    "Geistesgewalt,",
    "Wo Seel in Seele hinüber wallt.",
    "Ob auch zerspalten mir ist das Herz,",
    "Selig doch halten will ich den Schmerz,",
    "Ob auch zerspalten mir ist das Herz,",
    "Selig doch halten will ich den Schmerz,",
    "Ob"
   ]
  },
  {
   "lines_de": [
    "Auch zerspalten mir",
    "Ist das Herz,",
    "Selig doch halten will ich den Schmerz,",
    "Selig doch halten",
    "Will ich den Schmerz."
   ]
  }
 ],
 "poet_de": "Friedrich von Schlegel"
}