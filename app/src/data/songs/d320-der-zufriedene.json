{
 "d": "320",
 "title_de": "Der Zufriedene",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Zwar schuf das Glück hienieden mich weder reich noch gross,",
    "So ganz nach meinem Herzen ward mir ein Freund vergönnt:",
    "Allein ich bin zufrieden wie mit dem schönsten Loos,",
    "Denn Küssen, Trinken, Scherzen ist auch sein Element,",
    "Wie mit dem schönsten Loos,",
    "Ist auch sein Element."
   ]
  },
  {
   "lines_de": [
    "Mit ihm wird froh und weise",
    "Manch Fläschchen ausgeleert;",
    "Denn auf der Lebensreise",
    "Ist Wein das beste Pferd,",
    "Denn auf der Lebensreise,",
    "Ist Wein das beste Pferd."
   ]
  },
  {
   "lines_de": [
    "Wenn mir bei diesem Loose",
    "Nun auch ein trübres fällt,",
    "So denk ich: keine Rose",
    "Blüht dornlos in der Welt,",
    "So denk ich: keine Rose,",
    "Blüht dornlos in der Welt."
   ]
  }
 ],
 "poet_de": "Christian Reissig"
}