{
 "d": "688/2",
 "title_de": "Guarda, che bianca luna",
 "year": "1820",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Guarda, che bianca luna,",
    "guarda, che notte azzura!",
    "Un'aura non sussurra,",
    "nò, non tremola uno stel,",
    "nò, non tremola uno stel."
   ]
  },
  {
   "lines_de": [
    "L'usignoletto solo",
    "va dalla siepe all'orno,",
    "va dalla siepe all'orno,",
    "e sospirando intorno",
    "chiama la sua, la sua fedel,",
    "chiama la sua, la sua fedel."
   ]
  },
  {
   "lines_de": [
    "Ella, ch'el sente a pena,",
    "vien di fronda in fronda,",
    "e pare che gli dica:",
    "nò, non piangere, son qui,",
    "nò, non piangere, son qui."
   ]
  },
  {
   "lines_de": [
    "Che gemiti son questi,",
    "che dolci pianti, Irene,",
    "che dolci pianti son questi?",
    "Tu mai non me sapesti",
    "rispondere, rispondere così,",
    "rispondere, rispondere così."
   ]
  }
 ],
 "poet_de": "Pietro Metastasio, Jacopo Vittorelli"
}