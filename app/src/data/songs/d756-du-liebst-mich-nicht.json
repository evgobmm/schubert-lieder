 "title_de": "Du liebst mich nicht",
 "year": "1822",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Mein Herz ist zerrissen,",
    "du liebst mich nicht!",
    "du lie-ssest mich’s wissen,",
    "du liebst mich nicht!"
   ]
  },
  {
   "lines_de": [
    "Wiewohl ich dir flehend",
    "und werbend erschien,",
    "und liebebeflissen,",
    "du liebst mich nicht!"
   ]
  },
  {
   "lines_de": [
    "Du hast es gesprochen,",
    "mit Worten gesagt,",
    "mit allzugewissen,",
    "du liebst mich nicht!"
   ]
  },
  {
   "lines_de": [
    "So soll ich die Sterne,",
    "so soll ich den Mond,",
    "die Sonne vermissen?",
    "du liebst mich nicht!"
   ]
  },
  {
   "lines_de": [
    "Was blüht mir die Rose,",
    "was blüht der Jasmin,",
    "was blühn die Narzissen?",
    "du liebst, du liebst mich nicht,",
    "du liebst, du liebst mich nicht!"
   ]
  },
  {
   "lines_de": [
    "So soll ich die Sterne,",
