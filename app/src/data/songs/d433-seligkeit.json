{
 "d": "433",
 "title_de": "Seligkeit",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Freuden sonder Zahl",
    "Blühn im Himmelssaal",
    "Engeln und Verklärten,",
    "Wie die Väter lehrten.",
    "O da möcht' ich sein",
    "Und mich ewig freun!"
   ]
  },
  {
   "lines_de": [
    "Jedem lächelt traut",
    "Eine Himmelsbraut;",
    "Harf' und Psalter klinget,",
    "Und man tanzt und singet.",
    "O da möcht' ich sein",
    "Und mich ewig freun!"
   ]
  },
  {
   "lines_de": [
    "Lieber bleib ich hier,",
    "Lächelt Laura mir",
    "Einen Blick, der saget,",
    "Dass ich ausgeklaget.",
    "Selig dann mit ihr,",
    "Bleib ich ewig hier!"
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
}