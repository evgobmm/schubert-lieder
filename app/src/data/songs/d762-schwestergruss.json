{
 "d": "762",
 "title_de": "Schwestergruß",
 "year": "1822",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Im Mondenschein wall' ich auf und ab,",
    "Seh' Todtenbein und stilles Grab,"
   ]
  },
  {
   "lines_de": [
    "Im Mondenschein",
    "Wall' ich auf und ab,",
    "Seh' Todtenbein und stilles Grab,",
    "Seh' Todtenbein",
    "Und stilles Grab."
   ]
  },
  {
   "lines_de": [
    "In Geisterhauch",
    "Vorüber schwebt's,",
    "Wie Flamm' und Rauch",
    "Vorüber bebt's,"
   ]
  },
  {
   "lines_de": [
    "Aus Nebeltrug",
    "Steigt eine Gestalt",
    "Ohn' Sünd' und Lug,",
    "Vorüber wallt"
   ]
  },
  {
   "lines_de": [
    "Das Aug' so blau,",
    "Der Blick so gross wie",
    "In Himmels Au,",
    "Wie in Gottes Schooss,"
   ]
  },
  {
   "lines_de": [
    "Ein weiss Gewand",
    "Bedeckt das Bild,",
    "In zarter Hand",
    "Eine Lilie quillt,"
   ]
  },
  {
   "lines_de": [
    "In Geisterhauch",
    "Sie zu mir spricht:",
    "„Ich wandre schon",
    "Im reinen Licht,"
   ]
  },
  {
   "lines_de": [
    "Seh' Mond und Sonn'",
    "Zu meinem Fuss",
    "Und leb' in Wonn'",
    "In Engelkuss,"
   ]
  },
  {
   "lines_de": [
    "Und all die Lust,",
    "Die ich empfind,",
    "Nicht deine Brust",
    "Kennt, Menschenkind,"
   ]
  },
  {
   "lines_de": [
    "Wenn du nicht lässt",
    "Den Erdengott,",
    "Bevor dich fasst",
    "Der grause Tod.“"
   ]
  },
  {
   "lines_de": [
    "So tönt die Luft,",
    "So saust der Wind,",
    "Zu den Sternen ruft",
    "Das Himmelskind,"
   ]
  },
  {
   "lines_de": [
    "Und eh' sie flieht",
    "Die weisse Gestalt,",
    "In frischer Blüth'",
    "Sie sich entfalt',"
   ]
  },
  {
   "lines_de": [
    "In reiner Flamm'",
    "Schwebt sie empor,",
    "Ohne Schmerz und Harm,",
    "Zu der Engel Chor."
   ]
  },
  {
   "lines_de": [
    "Die Nacht verhüllt",
    "Den heil'gen Ort,",
    "Von Gott erfüllt",
    "Sing' ich das Wort."
   ]
  }
 ],
 "poet_de": "Franz von Bruchmann"
}