{
 "d": "631",
 "title_de": "Blanka",
 "year": "1818",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wenn mich einsam Lüfte fächeln,",
    "muss ich lächeln, wie ich kindisch",
    "tändelnd kose mit der Rose."
   ]
  },
  {
   "lines_de": [
    "Wären nicht die neuen Schmerzen,",
    "möcht' ich scherzen; könnt' ich, was ich",
    "ahnde, sagen, würd' ich klagen,",
    "und euch bange hoffend fragen:",
    "was verkünden meine Loose?",
    "Tändl' ich gleich mit Scherz und Rose,",
    "muss ich lächelnd dennoch klagen."
   ]
  }
 ],
 "poet_de": "Friedrich von Schlegel"
}