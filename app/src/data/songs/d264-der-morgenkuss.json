{
 "d": "264",
 "title_de": "Der Morgenkuß",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Durch eine ganze Nacht sich nah zu sein,",
    "So Hand in Hand, so Arm im Arme weilen,",
    "So viel empfinden, ohne mitzutheilen,",
    "Ist eine wonnevolle Pein,"
   ]
  },
  {
   "lines_de": [
    "So immer Seelenblick im Seelenblick,",
    "Auch den geheimsten Wunsch des Herzens sehn,",
    "Wenig sprechen und sich doch verstehen,",
    "Ist hohes martervolles Glück,"
   ]
  },
  {
   "lines_de": [
    "Zum Lohn für die im Zwang verschwund'ne Zeit,",
    "Dann bei dem Morgenstrahl, warm mit Entzücken,",
    "Mund an Mund und Herz an Herz zu drücken,",
    "O dies ist Engelseligkeit."
   ]
  },
  {
   "lines_de": [
    "Ist eine wonnevolle Pein,",
    "Pein ist eine wonnevolle Pein.",
    "Ist hohes martervolles Glück,",
    "Glück ist hohes martervolles Glück.",
    "O dies ist Engelseligkeit,",
    "Engelseligkeit, dies ist Engelseligkeit."
   ]
  }
 ],
 "poet_de": "Gabriele Batsányi"
}