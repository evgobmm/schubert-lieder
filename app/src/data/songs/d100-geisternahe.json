{
 "d": "100",
 "title_de": "Geisternähe",
 "year": "1814",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Der Dämm'rung Schein durchblinkt den Hain;",
    "Hier, beim Geräusch des Wasserfalles,",
    "Denk' ich nur dich, o du mein Alles!",
    "Dein Zauberbild erscheint, so mild",
    "Wie Hesperus im Abendgolde,",
    "Dem fernen Freund, geliebte Holde!"
   ]
  },
  {
   "lines_de": [
    "Er sehnt wie hier sich stets nach dir;",
    "Fest, wie den Stamm die Epheuranke,",
    "Umschlingt dich liebend sein Gedanke.",
    "Durchbebt dich auch im Abendhauch",
    "Des Brudergeistes leises Weh'n",
    "Mit Vorgefühl vom Wiedersehn?"
   ]
  },
  {
   "lines_de": [
    "Er ist's, der lind dir, süsses Kind,",
    "Des Schleiers Silbernebel kräuselt,",
    "Und in der Locken Fülle säuselt.",
    "Oft hörst du ihn, wie Melodien",
    "Der Wehmuth aus gedämpften Saiten",
    "In stiller Nacht vorübergleiten."
   ]
  },
  {
   "lines_de": [
    "Auch fesselfrei wird er getreu,",
    "Dir ganz und einzig hingegeben,",
    "In allen Welten dich umschweben."
   ]
  }
 ],
 "poet_de": "Friedrich von Matthisson"
}