 "stanzas": [
  {
   "lines_de": [
    "Nacht umhüllt mit wehendem Flügel",
    "Thäler und Hügel, ladend zur Ruh."
   ]
  },
  {
   "lines_de": [
    "Nacht umhüllet mit wehendem Flügel",
    "Thäler und Hügel, ladend zur Ruh."
   ]
  },
  {
   "lines_de": [
    "Und dem Schlummer, dem lieblichen Kinde,",
    "Leise und linde flüstert sie zu:"
   ]
  },
  {
   "lines_de": [
    "Weisst du ein Auge, wachend im Kummer?",
    "Lieblicher Schlummer, drücke mir's zu!",
    "Drücke mir's zu!"
   ]
  },
  {
   "lines_de": [
    "Fühlst du sein Nahen, ahnest du Ruh?",
    "Fühlst du sein Nahen, ahnest du Ruh?"
   ]
  },
  {
   "lines_de": [
    "Alles deckt Schlummer, alles, alles deckt der Schlummer,",
    "Schlummre, so schlummre auch du!"
   ]
  },
  {
   "lines_de": [
    "Alles deckt Schlummer, alles, alles",
    "Deckt der Schlummer,",
    "Schlummre, so schlummre auch du,",
    "Schlummre, so schlummre auch du!"
   ]
