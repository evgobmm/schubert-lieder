{
 "d": "653",
 "title_de": "Bertas Lied in der Nacht",
 "year": "1819",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Nacht umhüllt mit wehendem Flügel",
    "Thäler und Hügel, ladend zur Ruh."
   ]
  },
  {
   "lines_de": [
    "Nacht umhüllet",
    "Mit wehendem Flügel",
    "Thäler und Hügel,",
    "Ladend zur Ruh."
   ]
  },
  {
   "lines_de": [
    "Und dem Schlummer,",
    "Dem lieblichen Kinde,",
    "Leise und linde",
    "Flüstert sie zu:"
   ]
  },
  {
   "lines_de": [
    "Weisst du ein Auge,",
    "Wachend im Kummer?",
    "Lieblicher Schlummer,",
    "Drücke mir's zu!",
    "Drücke mir's zu!"
   ]
  },
  {
   "lines_de": [
    "Fühlst du sein Nahen, ahnest du Ruh?"
   ]
  },
  {
   "lines_de": [
    "Fühlst du sein Nahen,",
    "Ahnest du Ruh?"
   ]
  },
  {
   "lines_de": [
    "Alles deckt Schlummer, alles, alles deckt der Schlummer,",
    "Schlummre, so schlummre auch du!",
    "Alles deckt Schlummer, alles, alles",
    "Deckt der Schlummer,",
    "Schlummre, so schlummre auch du,",
    "Schlummre, so schlummre auch du!"
   ]
  }
 ],
 "poet_de": "Franz Grillparzer"
}