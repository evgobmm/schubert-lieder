{
 "d": "795/2",
 "title_de": "Wohin?",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Ich hört' ein Bächlein rauschen",
    "wohl aus dem Felsenquell,",
    "hinab zum Thale rauschen",
    "so frisch und wunderhell."
   ]
  },
  {
   "lines_de": [
    "Ich weiss nicht, wie mir wurde,",
    "nicht, wer den Rat mir gab,",
    "ich musste auch hinunter",
    "mit meinem Wanderstab,",
    "ich musste auch hinunter",
    "mit meinem Wanderstab."
   ]
  },
  {
   "lines_de": [
    "Hinunter und immer weiter,",
    "und immer dem Bache nach,",
    "und immer frischer rauschte",
    "und immer heller der Bach,",
    "und immer frischer rauschte",
    "und immer heller der Bach."
   ]
  },
  {
   "lines_de": [
    "Ist das denn meine Strasse?",
    "O Bächlein sprich, wohin?",
    "wohin? sprich, wohin?",
    "Du hast mit deinem Rauschen",
    "mir ganz berauscht den Sinn,",
    "du hast mit deinem Rauschen",
    "mir ganz berauscht den Sinn."
   ]
  },
  {
   "lines_de": [
    "Was sag ich denn vom Rauschen?",
    "das kann kein Rauschen sein:",
    "Es singen wohl die Nixen",
    "tief unten ihren Reih'n,",
    "es singen wohl die Nixen",
    "tief unten ihren Reih'n."
   ]
  },
  {
   "lines_de": [
    "Lass singen, Gesell, lass rauschen,",
    "und wand're fröhlich nach!",
    "Es geh'n ja Mühlenräder",
    "in jedem klaren Bach,",
    "es geh'n ja Mühlenräder",
    "in jedem klaren Bach."
   ]
  },
  {
   "lines_de": [
    "Lass singen, Gesell, lass rauschen,",
    "und wand're fröhlich nach,",
    "fröhlich nach, fröhlich nach!"
   ]
  }
 ],
 "poet_de": "Wilhelm Müller"
}