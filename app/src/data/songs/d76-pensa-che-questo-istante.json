{
 "d": "76",
 "title_de": "Pensa che questo istante",
 "year": "1813",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Pensa che questo istante",
    "del tuo destin decide;",
    "oggi rinasce Alcide",
    "per la futura età.",
    "Pensa che adulto sei,",
    "che sei di Giove un figlio;",
    "che merto, non consiglio,",
    "la scelta tua sarà."
   ]
  },
