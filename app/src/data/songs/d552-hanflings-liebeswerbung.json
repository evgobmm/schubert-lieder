 "title_de": "Hänflings Liebeswerbung",
 "year": "1817",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Ahidi, ich liebe!",
    "Mild lächelt die Sonne, mild,",
    "Wehen die Weste sanft,",
    "Rieselt die Quelle süss,",
    "Duften die Blumen —",
    "Ich liebe,"
   ]
  },
  {
   "lines_de": [
    "Ahidi, ich liebe!",
    "Dich lieb’ ich, du Sanfte, mit",
    "Seidenem Gefieder,",
    "Mit strahlenden Äuglein dich,",
    "Schönste der Schwestern —",
    "Ich liebe,"
   ]
  },
  {
   "lines_de": [
    "Ahidi, ich liebe!",
    "O sieh, wie die Blumen",
    "Sich liebevoll grüssen,",
    "Sich liebevoll nicken,",
    "O liebe mich wieder —",
    "Ich liebe,"
   ]
  },
  {
   "lines_de": [
    "Ahidi, ich liebe!",
    "O sieh, wie der Epheu",
    "Mit liebenden Armen",
    "Die Eiche umschlinget,",
    "O liebe mich wieder —",
    "Ich liebe, ahidi, ich liebe!"
   ]
  },
  {
   "lines_de": [
    "Ahidi, ich liebe!",
    "Ich liebe, Ahidi!"
   ]
  },
  {
   "lines_de": [
    "Ahidi, ich liebe!",
    "Ich liebe, Ahidi!"
   ]
  }
