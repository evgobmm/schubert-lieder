{
 "d": "270",
 "title_de": "An die Sonne",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Sinke, liebe Sonne, sinke,",
    "Ende deinen trüben Lauf,",
    "Und an deiner Stelle winke",
    "Bald den Mond herauf,",
    "Bald den Mond herauf!"
   ]
  },
  {
   "lines_de": [
    "Herrlicher und schöner",
    "Dringe er morgen dann herfür,",
    "Liebe Sonn', und mit dir bringe",
    "Meinen Lieben mir,",
    "Meinen Lieben mir!"
   ]
  }
 ],
 "poet_de": "Gabriele Batsányi"
}