{
 "d": "596",
 "title_de": "Lied eines Kindes",
 "year": "1817",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Lauter Freude fühl ich,",
    "Lauter Liebe hör ich,",
    "Ich so überglücklich,",
    "Fröhlich spielend Kind.",
    "Dort der gute Vater,",
    "Hier die liebe Mutter,",
    "Rund herum wir Kinder,",
    "Rund herum wir Kinder."
   ]
  }
 ],
 "poet_de": "unbekannt"
}