{
 "d": "412",
 "title_de": "Stimme der Liebe",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Meine Selinde!",
    "denn mit Engelstimme",
    "singt die Liebe mir zu:",
    "sie wird die Deine!",
    "Sie wird die Meine!",
    "Himmel und Erde schwinden!",
    "Meine Selinde!",
    "Meine Selinde!"
   ]
  },
  {
   "lines_de": [
    "Thränen der Sehsucht,",
    "die auf blassen Wangen bebten,",
    "fallen herab als Freudenthränen!",
    "Denn mir tönt die himmlische Stimme:",
    "Deine wird sie, die Deine!"
   ]
  }
 ],
 "poet_de": "Friedrich Leopold zu Stolberg-Stolberg"
}