{
 "d": "117",
 "title_de": "Das Mädchen aus der Fremde",
 "year": "1814",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "In einem Thal bei armen Hirten",
    "Erschien mit jedem jungen Jahr,",
    "Sobald die ersten Lerchen schwirrten,",
    "Ein Mädchen schön und wunderbar."
   ]
  },
  {
   "lines_de": [
    "Sie war nicht in dem Thal geboren,",
    "Man wusste nicht, woher sie kam,",
    "Doch schnell war ihre Spur verloren,",
    "Sobald das Mädchen Abschied nahm."
   ]
  },
  {
   "lines_de": [
    "Beseligend war ihre Nähe,",
    "Und alle Herzen wurden weit,",
    "Doch eine Würde, eine Höhe",
    "Entfernte die Vertraulichkeit."
   ]
  },
  {
   "lines_de": [
    "Sie brachte Blumen mit und Früchte,",
    "Gereift auf einer andern Flur,",
    "In einem andern Sonnenlichte,",
    "In einer glücklichern Natur,"
   ]
  },
  {
   "lines_de": [
    "Und theilte jedem eine Gabe,",
    "Dem Früchte, jenem Blumen aus,",
    "Der Jüngling und der Greis am Stabe,",
    "Ein jeder ging beschenkt nach Haus."
   ]
  },
  {
   "lines_de": [
    "Willkommen waren alle Gäste,",
    "Doch nahte, nahte sich ein liebend Paar,",
    "Dem reichte sie der Gabe beste,",
    "Der Blumen allerschönste dar."
   ]
  }
 ],
 "poet_de": "Friedrich Schiller"
}