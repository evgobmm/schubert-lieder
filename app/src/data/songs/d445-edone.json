{
 "d": "445",
 "title_de": "Edone",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Dein süsses Bild, Edone, schwebt",
    "Stets vor meinem Blick, allein",
    "Ihn trüben Zähren,",
    "Dass du es selbst nicht bist, nicht bist."
   ]
  },
  {
   "lines_de": [
    "Ich seh es, wenn der Abend mir dämmert,",
    "Wenn der Mond",
    "Mir glänzt, seh ich's, und weine,",
    "Dass du es selbst nicht bist."
   ]
  },
  {
   "lines_de": [
    "Bei jenes Thales Blumen,",
    "Die ich ihr lesen will,",
    "Bei jenen Myrtenzweigen,",
    "Die ich ihr flechten will,"
   ]
  },
  {
   "lines_de": [
    "Beschwör ich dich, Erscheinung, auf,",
    "Und verwandle dich,",
    "Verwandle dich, Erscheinung,",
    "Und werd Edone selbst!"
   ]
  }
 ],
 "poet_de": "Friedrich Gottlieb Klopstock"
}