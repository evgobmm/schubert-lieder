{
 "d": "795/18",
 "title_de": "Trockne Blumen",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Ihr Blümlein alle,",
    "Die sie mir gab,",
    "Euch soll man legen",
    "Mit mir in’s Grab."
   ]
  },
  {
   "lines_de": [
    "Wie seht ihr alle",
    "Mich an so weh,",
    "Als ob ihr wüsstet,",
    "Wie mir gescheh’?"
   ]
  },
  {
   "lines_de": [
    "Ihr Blümlein alle,",
    "Wie welk, wie blass?",
    "Ihr Blümlein alle,",
    "Wovon so nass?"
   ]
  },
  {
   "lines_de": [
    "Ach, Tränen machen",
    "Nicht maiengrün,",
    "Machen tote Liebe",
    "Nicht wieder blüh’n,"
   ]
  },
  {
   "lines_de": [
    "Und Lenz wird kommen,",
    "Und Winter wird geh’n,",
    "Und Blümlein werden",
    "Im Grase steh’n,"
   ]
  },
  {
   "lines_de": [
    "Und Blümlein liegen",
    "In meinem Grab,",
    "Die Blümlein alle,",
    "Die sie mir gab."
   ]
  },
  {
   "lines_de": [
    "Und wenn sie wandelt",
    "Am Hügel vorbei",
    "Und denkt im Herzen,",
    "Der meint’ es treu!"
   ]
  },
  {
   "lines_de": [
    "Dann Blümlein alle",
    "Heraus, heraus!",
    "Der Mai ist kommen,",
    "Der Winter ist aus."
   ]
  },
  {
   "lines_de": [
    "Und wenn sie wandelt",
    "Am Hügel vorbei,",
    "Und denkt im Herzen,",
    "Der meint’ es treu!"
   ]
  },
  {
   "lines_de": [
    "Dann Blümlein alle",
    "Heraus, heraus!",
    "Der Mai ist kommen,",
    "Der Winter ist aus,"
   ]
  },
