{
 "d": "795/18",
 "title_de": "Trockne Blumen",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Ihr Blümlein alle,",
    "die sie mir gab,",
    "euch soll man legen",
    "mit mir in’s Grab."
   ]
  },
  {
   "lines_de": [
    "Wie seht ihr alle",
    "mich an so weh,",
    "als ob ihr wüsstet,",
    "wie mir gescheh’?"
   ]
  },
  {
   "lines_de": [
    "Ihr Blümlein alle,",
    "wie welk, wie blass?",
    "ihr Blümlein alle,",
    "wovon so nass?"
   ]
  },
  {
   "lines_de": [
    "Ach, Tränen machen",
    "nicht maiengrün,",
    "machen tote Liebe",
    "nicht wieder blüh’n,"
   ]
  },
  {
   "lines_de": [
    "und Lenz wird kommen,",
    "und Winter wird geh’n,",
    "und Blümlein werden",
    "im Grase steh’n,"
   ]
  },
  {
   "lines_de": [
    "und Blümlein liegen",
    "in meinem Grab,",
    "die Blümlein alle,",
    "die sie mir gab."
   ]
  },
  {
   "lines_de": [
    "Und wenn sie wandelt",
    "am Hügel vorbei",
    "und denkt im Herzen,",
    "der meint’ es treu!"
   ]
  },
  {
   "lines_de": [
    "dann Blümlein alle",
    "heraus, heraus!",
    "der Mai ist kommen,",
    "der Winter ist aus."
   ]
  },
  {
   "lines_de": [
    "Und wenn sie wandelt",
    "am Hügel vorbei,",
    "und denkt im Herzen,",
    "der meint’ es treu!"
   ]
  },
  {
   "lines_de": [
    "dann Blümlein alle",
