 "title_de": "Halt!",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Eine Mühle seh ich blinken",
    "aus den Erlen heraus,",
    "durch Rauschen und Singen",
    "bricht Rädergebraus,",
    "bricht Rädergebraus."
   ]
  },
  {
   "lines_de": [
    "Ei willkommen, ei willkommen,",
    "süsser Mühlengesang,",
    "ei willkommen, ei willkommen,",
    "süsser Mühlengesang.!"
   ]
  },
  {
   "lines_de": [
    "Und das Haus, wie so traulich!",
    "und die Fenster, wie blank!",
    "und die Sonne, wie helle",
    "vom Himmel sie scheint,",
    "die Sonne, wie helle",
    "vom Himmel sie scheint!"
   ]
  },
  {
   "lines_de": [
    "Ei, Bächlein, liebes Bächlein,",
    "war es also gemeint?",
    "ei, Bächlein, liebes Bächlein,",
    "war es also gemeint?",
    "war es also gemeint?",
    "war es also gemeint?"
   ]
  }
 ],
 "poet_de": "Wilhelm Müller"
}