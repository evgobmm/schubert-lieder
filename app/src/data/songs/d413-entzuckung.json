{
 "d": "413",
 "title_de": "Entzückung",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Tag voll Himmel, da aus Laura's Blicken",
    "Mir der Liebe heiligstes Entzücken",
    "In die wonnetrunkne Seele drang;",
    "Und von ihrem Zauber hingerissen,",
    "Ich der Holden unter Feuerküssen",
    "An den süssbeklommnen Busen sank."
   ]
  },
  {
   "lines_de": [
    "Goldner sah ich Wolken sich besäumen,",
    "Jedes Blättchen auf den Frühlingsbäumen",
    "Schien zu flüstern, schien zu flüstern:",
    "Ewig dein, ewig, ewig dein, Glücklicher!",
    "In solcher Taumelfülle werd ich",
    "Nach verstäubter Erdenhülle",
    "Kaum in edens Myrthenlauben sein."
   ]
  },
  {
   "lines_de": [
    "Tag voll Himmel, da aus Laura's Blicken",
    "Mir der Liebe heiligstes Entzücken",
    "In die wonnetrunkne Seele,",
    "In die wonnetrunkne Seele drang."
   ]
  }
 ],
 "poet_de": "Friedrich von Matthisson"
}