{
 "d": "116",
 "title_de": "Der Geistertanz",
 "year": "1814",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Die bretterne Kammer",
    "Der Todten erbebt,",
    "Wenn zwölfmal den Hammer",
    "Die Mitternacht hebt."
   ]
  },
  {
   "lines_de": [
    "Rasch tanzen um Gräber",
    "Und morsches Gebein",
    "Wir luftigen Schweber",
    "Den sausenden Reihn."
   ]
  },
  {
   "lines_de": [
    "Was winseln die Hunde",
    "Beim schlafenden Herrn?",
    "Sie wittern die Runde",
    "Der Geister von fern."
   ]
  },
  {
   "lines_de": [
    "Die Raben entflattern",
    "Der wüsten Abtei",
    "Und flieh'n an den Gattern",
    "Des Kirchhofs vorbei."
   ]
  },
  {
   "lines_de": [
    "Wir gaukeln und scherzen",
    "Hinab und empor,",
    "Gleich irrenden Kerzen",
    "Im dunstigen Moor."
   ]
  },
  {
   "lines_de": [
    "Herz, dessen Zauber",
    "Zur Marter uns ward,",
    "Du ruhst nun in tauber",
    "Verdumpfung erstarrt.",
    "Tief bargst du im düstern Gemach unser Weh,",
    "Wir Glücklichen flüstern dir fröhlich Ade!"
   ]
  },
  {
   "lines_de": [
    "Tief bargst du im düstern",
    "Gemach unser Weh,",
    "Wir Glücklichen flüstern",
    "Dir fröhlich Ade!"
   ]
  }
 ],
 "poet_de": "Friedrich von Matthisson"
}