{
 "d": "691",
 "title_de": "Die Vögel",
 "year": "1820",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wie lieblich und fröhlich,",
    "Zu schweben, zu singen,",
    "Von glänzender Höhe",
    "Zur Erde zu blicken!",
    "Die Menschen sind thöricht,",
    "Sie können nicht fliegen,",
    "Sie können nicht fliegen!"
   ]
  },
  {
   "lines_de": [
    "Sie jammern in Nöthen,",
    "Wir flattern gen Himmel,",
    "Wir flattern gen Himmel!",
    "Der Jäger will tödten,",
    "Dem Früchte wir pickten;",
    "Wir müssen ihn höhnen",
    "Und Beute gewinnen."
   ]
  }
 ],
 "poet_de": "Friedrich von Schlegel"
}