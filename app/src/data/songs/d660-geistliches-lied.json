{
 "d": "660",
 "title_de": "Geistliches Lied",
 "year": "1819",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wenn ich ihn nur habe,",
    "Wenn er mein nur ist,",
    "Wenn mein Herz bis hin zum Grabe",
    "Seine Treue nie vergisst:",
    "Weiss ich nichts von Leide,",
    "Fühle nichts, als Andacht, Lieb' und Freude."
   ]
  },
  {
   "lines_de": [
    "Wenn ich ihn nur habe,",
    "Lass' ich alles gern,",
    "Folg' an meinem Wanderstabe",
    "Treugesinnt nur meinem Herrn;",
    "Lasse still die Andern",
    "Breite, lichte, volle Strassen wandern."
   ]
  },
  {
   "lines_de": [
    "Wenn ich ihn nur habe,",
    "Schlaf' ich fröhlich ein,",
    "Ewig wird zu süsser Labe",
    "Seines Herzens Fluth mir sein,",
    "Die mit sanftem Zwingen",
    "Alles wird erweichen und durchdringen."
   ]
  },
  {
   "lines_de": [
    "Wenn ich ihn nur habe,",
    "Hab' ich auch die Welt;",
    "Selig, wie ein Himmelsknabe,",
    "Der der Jungfrau Schleier hält.",
    "Hingesenkt im Schauen",
    "Kann mir vor dem Irdischen nicht grauen."
   ]
  },
  {
   "lines_de": [
    "Wo ich ihn nur habe,",
    "Ist mein Vaterland;",
    "Und es fällt mir jede Gabe",
    "Wie ein Erbtheil in die Hand:",
    "Längst vermisste Brüder",
    "Find' ich nun in seinen Jüngern wieder."
   ]
  }
 ],
 "poet_de": "Novalis"
}