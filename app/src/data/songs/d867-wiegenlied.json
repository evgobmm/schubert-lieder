{
 "d": "867",
 "title_de": "Wiegenlied",
 "year": "1826",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wie sich der Äuglein",
    "Kindlicher Himmel",
    "Schlummerbelastet",
    "Lässig verschliesst:",
    "Schliesse sie einst,",
    "Lockt dich die Erde,",
    "Drinnen ist Himmel,",
    "Aussen ist Lust!"
   ]
  },
  {
   "lines_de": [
    "Wie dir so schlafroth",
    "Glühet die Wange,",
    "Rosen, aus Eden",
    "Hauchten sie an:",
    "Rosen die Wangen,",
    "Himmel die Augen,",
    "Heiterer Morgen,",
    "Himmlischer Tag!"
   ]
  },
  {
   "lines_de": [
    "Wie des Gelockes",
    "Goldige Wallung",
    "Kühlet der Schläfe",
    "Glühenden Saum:",
    "Schön ist das Goldhaar,",
    "Schöner der Kranz drauf,",
    "Träum du vom Lorbeer,",
    "Bis er dir blüht!"
   ]
  },
  {
   "lines_de": [
    "Liebliches Mündchen,",
    "Engel umwehn dich,",
    "Drinnen die Unschuld,",
    "Drinnen die Lieb:",
    "Wahre sie, Kindchen,",
    "Wahre sie treulich,",
    "Lippen sind Rosen,",
    "Lippen sind Gluth!"
   ]
  },
  {
   "lines_de": [
    "Wie dir ein Engel",
    "Faltet die Händchen,",
    "Falte sie einst so,",
    "Gehst du zur Ruh:",
    "Schön sind die Träume,",
    "Wenn man gebetet,",
    "Und das Erwachen",
    "Lohnt mit dem Traum!"
   ]
  }
 ],
 "poet_de": "Johann Gabriel Seidl"
}