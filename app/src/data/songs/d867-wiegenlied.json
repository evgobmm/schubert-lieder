{
 "d": "867",
 "title_de": "Wiegenlied",
 "year": "1826",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wie sich der Äuglein",
    "kindlicher Himmel",
    "Schlummerbelastet",
    "lässig verschliesst:",
    "Schliesse sie einst,",
    "lockt dich die Erde,",
    "Drinnen ist Himmel,",
    "Aussen ist Lust!"
   ]
  },
  {
   "lines_de": [
    "Wie dir so schlafroth",
    "glühet die Wange,",
    "Rosen, aus Träumen",
    "hauchten sie an:",
    "Rosen die Wangen,",
    "Himmel die Augen,",
    "Heiterer Morgen,",
    "himmlischer Tag!"
   ]
  },
  {
   "lines_de": [
    "Wie des Gelockes",
    "goldige Wallung",
    "Kühlet der Schläfe",
    "glühenden Saum:",
    "Schön ist das Goldhaar,",
    "schöner der Kranz drauf,",
    "Träum du vom Lorbeer,",
    "bis er dir blüht!"
   ]
  },
  {
   "lines_de": [
    "Liebliches Mündchen,",
    "Engel umwehn dich,",
    "Drinnen die Unschuld,",
    "drinnen die Lieb:",
    "Wahre sie, Kindchen,",
    "wahre sie treulich,",
    "Lippen sind Rosen,",
    "Lippen sind Gluth!"
   ]
  },
  {
   "lines_de": [
    "Wie dir ein Engel",
    "faltet die Händchen,",
    "Falte sie einst so,",
    "gehst du zur Ruh:",
    "Schön sind die Träume,",
    "wenn man gebetet,",
    "Und das Erwachen",
    "Lohnt mit dem Traum!"
   ]
  }
 ],
 "poet_de": "Johann Gabriel Seidl"
}