{
 "d": "744",
 "title_de": "Schwanengesang",
 "year": "1822",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wie klag ich's aus das Sterbegefühl,",
    "Das auflösend durch die Glieder rinnt?",
    "Wie sing ich's aus das Werdegefühl,",
    "Das erlösend dich, o Geist, anweht?"
   ]
  },
  {
   "lines_de": [
    "Erklagt, ersang,",
    "Vernichtungsbang, verklärungsfroh,",
    "Bis das Leben floh:",
    "Das bedeutet des Schwanen Gesang."
   ]
  }
 ],
 "poet_de": "Johann Senn"
}