{
 "d": "778",
 "title_de": "Greisengesang",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Der Frost hat mir bereifet",
    "Des Hauses Dach;",
    "Doch warm ist’s mir geblieben",
    "Im Wohngemach."
   ]
  },
  {
   "lines_de": [
    "Der Winter hat die Scheitel",
    "Mir weiss gedeckt;",
    "Doch fliesst das Blut, das rote,",
    "Durch’s Herzgemach."
   ]
  },
  {
   "lines_de": [
    "Der Jugendflor der Wangen,",
    "Die Rosen sind",
    "Gegangen, all’ gegangen",
    "Einander nach."
   ]
  },
  {
   "lines_de": [
    "Wo sind sie hingegangen?",
    "In’s Herz hinab.",
    "Da blüh’n sie nach Verlangen,",
    "Wie vor so nach,",
    "Nach Verlangen, wie vor so nach."
   ]
  },
  {
   "lines_de": [
    "Sind alle Freudenströme",
    "Der Welt versiegt?",
    "Noch fliesst mir durch den Busen",
    "Ein stiller Bach."
   ]
  },
  {
   "lines_de": [
    "Sind alle Nachtigallen",
    "Der Flur verstummt?",
    "Noch ist bei mir im Stillen",
    "Hier eine wach."
   ]
  },
  {
   "lines_de": [
    "Sie singet: Herr des Hauses!",
    "Verschleuss dein Thor,",
    "Dass nicht die Welt, die kalte,",
    "Dring’ in’s Gemach."
   ]
  },
  {
   "lines_de": [
    "Schleuss aus den rauhen Odem",
    "Der Wirklichkeit,",
    "Und nur dem Duft der Träume,",
    "Und nur dem Duft der Träume gib Dach und Fach,",
    "Dem Duft der Träume gib Dach und Fach."
   ]
  }
 ],
 "poet_de": "Friedrich Rückert"
}