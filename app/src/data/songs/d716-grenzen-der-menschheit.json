{
 "d": "716",
 "title_de": "Grenzen der Menschheit",
 "year": "1821",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wenn der uralte,",
    "Heilige Vater",
    "Mit gelassener Hand",
    "Aus rollenden Wolken",
    "Segnende Blitze",
    "Über die Erde sät,",
    "Küss ich den letzten",
    "Saum seines Kleides,",
    "Kindliche Schauer",
    "Trag ich im Busen.",
    "Küss ich den letzten",
    "Saum seines Kleides,",
    "Kindliche Schauer",
    "Trag ich im Busen."
   ]
  },
  {
   "lines_de": [
    "Denn mit Göttern",
    "Soll sich nicht messen",
    "Irgend ein Mensch.",
    "Hebt er sich aufwärts",
    "Und berührt",
    "Mit dem Scheitel die Sterne,",
    "Nirgends haften dann",
    "Die unsichern Sohlen,",
    "Und mit ihm spielen",
    "Wolken und Winde.",
    "Nirgends haften dann",
    "Die unsichern Sohlen,",
    "Und mit ihm spielen",
    "Wolken und Winde."
   ]
  },
  {
   "lines_de": [
    "Steht er mit festen,",
    "Markigen Knochen",
    "Auf der wohlgegründeten",
    "Dauernden Erde,",
    "Reicht er nicht auf,",
    "Nur mit der Eiche",
    "Oder der Rebe",
    "Sich zu vergleichen."
   ]
  },
  {
   "lines_de": [
    "Was unterscheidet",
    "Götter von Menschen?",
    "Dass viele Wellen",
    "Vor jenen wandeln,",
    "Ein ewiger Strom:",
    "Uns hebt die Welle,",
    "Verschlingt die Welle,",
    "Und wir versinken,",
    "Und wir versinken."
   ]
  },
  {
   "lines_de": [
    "Ein kleiner Ring",
    "Begrenzt unser Leben,",
    "Und viele Geschlechter",
    "Reihen sich dauernd",
    "An ihres Daseins",
    "Unendliche Kette,",
    "An ihres Daseins",
    "Unendliche Kette."
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}