{
 "d": "297",
 "title_de": "Augenlied",
 "year": "1817",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Süße Augen, klare Bronnen,",
    "Meine Qual und Seligkeit",
    "Ist fürwahr aus euch gewonnen,",
    "Und mein Dichten euch geweiht."
   ]
  },
  {
   "lines_de": [
    "Wo ich weile,",
    "Wie ich eile,",
    "Liebend strahlet ihr mich an,",
    "Ihr erleuchtet, ihr befeuchtet",
    "Mir mit Thränen meine Bahn.",
    "Ihr erleuchtet,",
    "Ihr befeuchtet",
    "Mir mit Thränen meine Bahn."
   ]
  },
  {
   "lines_de": [
    "Treue Sterne, schwindet nimmer,",
    "Leitet mich zum Acheron,",
    "Und mit eurem letzten Schimmer",
    "Sei mein Leben auch entflohn.",
    "Treu' Sterne, schwindet nimmer,",
    "Treu' Sterne, schwindet nimmer,",
    "Leitet mich, mich zum Charon.",
    "Und mit eurem letzten Schimmer",
    "Sei mein Leben auch entflohn,",
    "Und mit eurem letzten Schimmer",
    "Sei mein Leben auch entflohn,",
    "Und mit eurem letzten Schimmer",
    "Sei mein Leben, sei mein Leben",
    "Auch entflohn."
   ]
  }
 ],
 "poet_de": "Johann Mayrhofer"
}