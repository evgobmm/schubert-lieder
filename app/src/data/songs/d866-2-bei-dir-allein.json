{
 "d": "866/2",
 "title_de": "Bei dir allein!",
 "year": "1828",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Bei dir allein Empfind' ich, daß ich lebe,",
    "Daß Jugendmuth mich schwellt,",
    "Daß eine heit're Welt",
    "Der Liebe mich durchbebe;",
    "Mich freut mein Sein,",
    "Bei dir allein! Bei dir allein! Bei dir allein!",
    "Mich freut mein Sein,",
    "Bei dir allein! Bei dir allein!",
    "Bei dir allein"
   ]
  },
  {
   "lines_de": [
    "Weht mir die Luft so labend,",
    "Dünkt mich die Flur so grün,",
    "So mild des Lenzes Blühn,",
    "So balsamreich der Abend,",
    "So kühl der Hain,",
    "Bei dir allein! Bei dir allein! Bei dir allein!",
    "So kühl der Hain,",
    "Bei dir allein! Bei dir allein!",
    "Bei dir allein"
   ]
  },
  {
   "lines_de": [
    "Verliert der Schmerz sein Herbes,",
    "Gewinnt die Freud' an Lust,",
    "Du sicherst meine Brust",
    "Des angestammten Erbes,",
    "Ich fühl' mich mein",
    "Bei dir allein! Bei dir allein! Bei dir allein!",
    "Ich fühl' mich mein",
    "Bei dir allein! Bei dir allein!"
   ]
  }
 ],
 "poet_de": "Johann Gabriel Seidl"
}