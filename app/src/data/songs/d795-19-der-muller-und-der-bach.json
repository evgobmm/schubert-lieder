{
 "d": "795/19",
 "title_de": "Der Müller und der Bach",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wo ein",
    "Treues Herze in",
    "Liebe vergeht,",
    "Da welken die Lilien",
    "Auf jedem Beet;"
   ]
  },
  {
   "lines_de": [
    "Da muss in die Wolken",
    "Der Vollmond geh'n,",
    "Damit seine Thränen",
    "Die Menschen nicht seh'n;"
   ]
  },
  {
   "lines_de": [
    "Da halten die Englein",
    "Die Augen sich zu",
    "Und schluchzen und",
    "Singen die Seele"
   ]
  },
  {
   "lines_de": [
    "Zur Ruh.",
    "Und wenn sich die Liebe",
    "Dem Schmerz entringt,",
    "Ein Sternlein, ein neues, am Himmel erblinkt,",
    "Ein Sternlein, ein neues,",
    "Am Himmel erblinkt;"
   ]
  },
  {
   "lines_de": [
    "Da springen drei Rosen",
    "Halb roth und halb weiss,",
    "Die welken nicht wieder,",
    "Aus Dornenreis;"
   ]
  },
  {
   "lines_de": [
    "Und die Englein schneiden",
    "Die Flügel sich ab",
    "Und geh'n alle Morgen zur Erde herab,",
    "Und geh'n alle Morgen",
    "Zur Erde herab."
   ]
  },
  {
   "lines_de": [
    "Ach, Bächlein,",
    "Liebes Bächlein, du",
    "Meinst es so gut,",
    "Ach, Bächlein, aber weisst du",
    "Wie Liebe thut?"
   ]
  },
  {
   "lines_de": [
    "Ach, unten, da unten",
    "Die kühle Ruh,",
    "Ach, Bächlein, liebes Bächlein, so singe nur zu,",
    "Ach, Bächlein, liebes Bächlein,",
    "So singe nur zu!"
   ]
  }
 ],
 "poet_de": "Wilhelm Müller"
}