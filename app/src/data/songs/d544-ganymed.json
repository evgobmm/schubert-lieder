{
 "d": "544",
 "title_de": "Ganymed",
 "year": "1817",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wie im Morgenglanze",
    "Du rings mich anglühst,",
    "Frühling, Geliebter!",
    "Mit tausendfacher Liebeswonne",
    "Sich an mein Herze drängt",
    "Deiner ewigen Wärme",
    "Heilig Gefühl,",
    "Unendliche Schöne!"
   ]
  },
  {
   "lines_de": [
    "Dass ich dich fassen möcht'",
    "In diesen Arm!"
   ]
  },
  {
   "lines_de": [
    "Ach, an deinem Busen",
    "Lieg' ich und schmachte,",
    "Und deine Blumen, dein Gras",
    "Drängen sich an mein Herz.",
    "Du kühlst den brennenden Durst",
    "Meines Busens,",
    "Lieblicher Morgenwind!",
    "Ruft drein die Nachtigall",
    "Liebend nach mir aus dem Nebelthal.",
    "Ich komm', ich komme!",
    "Ach, wohin? wohin?"
   ]
  },
  {
   "lines_de": [
    "Hinauf strebt's, hinauf!"
   ]
  },
  {
   "lines_de": [
    "Hinauf strebt's, hinauf!",
    "Es schweben die Wolken",
    "Abwärts, die Wolken",
    "Neigen sich der sehnenden Liebe.",
    "Mir! Mir!",
    "In eurem Schoosse",
    "Aufwärts!",
    "Umfangend umfangen!"
   ]
  },
  {
   "lines_de": [
    "Aufwärts an deinen Busen,",
    "Alliebender Vater!"
   ]
  },
  {
   "lines_de": [
    "Die Wolken neigen sich der sehnenden Liebe.",
    "Mir! Mir!",
    "In eurem Schoosse",
    "Aufwärts!",
    "Umfangend umfangen!",
    "Aufwärts an deinen Busen,",
    "Alliebender Vater,",
    "Alliebender Vater!"
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}