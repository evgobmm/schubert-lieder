{
 "d": "496",
 "title_de": "Bei dem Grabe meines Vaters",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Friede sei um diesen Grabstein her,",
    "Sanfter Friede Gottes!"
   ]
  },
  {
   "lines_de": [
    "Ach, sie haben einen guten Mann begraben,",
    "Und mir war er mehr!"
   ]
  },
  {
   "lines_de": [
    "Ein leiser süsser Trost von Gott",
    "Und ein Ahnden von dem ewgen Leben",
    "Träufte mir von oben,",
    "Duft' um sein Gebein,",
    "Bis ihn Jesus Christus, gross und hehr,",
    "Wecken wird."
   ]
  },
  {
   "lines_de": [
    "Ach, sie haben ihn begraben,",
    "Einen guten Mann begraben,",
    "Und mir war er mehr!"
   ]
  },
  {
   "lines_de": [
    "Träufte mir von Segen, dieser Mann,",
    "Wie ein Stern aus bessern Welten!",
    "Und ich kann's ihm nicht vergelten,",
    "Was er mir gethan!"
   ]
  },
  {
   "lines_de": [
    "Und ich kann's ihm nicht vergelten,",
