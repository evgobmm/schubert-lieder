{
 "d": "738",
 "title_de": "Im Haine",
 "year": "1822",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Sonnenstrahlen durch die Tannen fallen,",
    "ziehn von dannen alle Schmerzen,",
    "und im Herzen wohnet reiner Friede nur —",
    "ziehn von dannen alle Schmerzen,",
    "und im Herzen wohnet reiner Friede nur,",
    "wohnet reiner Friede nur."
   ]
  },
  {
   "lines_de": [
    "Wie stilles Sausen lauer Lüfte,",
    "und im Thau zarte Düfte, die sich neigen aus den Zweigen,",
    "atmet aus die ganze Flur —",
    "zarte Düfte, die sich neigen aus den Zweigen,",
    "atmet aus die ganze Flur,",
    "atmet aus die ganze Flur."
   ]
  },
  {
   "lines_de": [
    "Wenn nur immer dunkle Bäume Sonnenschimmer, grüne Säume",
    "uns umblühten und umglühten,",
    "tilgend aller Qualen Spur —",
    "grüne Säume, uns umblühten und umglühten,",
    "tilgend aller Qualen Spur,",
    "tilgend aller Qualen Spur."
   ]
  }
 ],
 "poet_de": "Franz von Bruchmann"
}