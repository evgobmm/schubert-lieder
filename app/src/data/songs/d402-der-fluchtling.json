{
 "d": "402",
 "title_de": "Der Flüchtling",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Frisch athmet des Morgens lebendiger Hauch,",
    "Purpurisch zuckt durch düstrer Tannen Ritzen das junge Licht",
    "Und äugelt aus dem Strauch",
    "In goldnen Flammen blitzen",
    "Der Berge Wolkenspitzen.",
    "Mit freudig melodisch gewirbeltem Lied",
    "Begrüssen erwachende Lerchen die Sonne,",
    "Die schon in lachender Wonne",
    "Jugendlich schön in Aurora's Umarmungen glüht."
   ]
  },
  {
   "lines_de": [
    "Sei, Licht, mir gesegnet!",
    "Dein Strahlengruss regnet wärmend",
    "Hernieder auf Anger und Au.",
    "Wie flittern",
    "Die Wiesen, wie silberfarb zittern",
    "Tausend Sonnen im perlenden Thau!"
   ]
  },
  {
   "lines_de": [
    "In säuselnder Kühle",
    "Beginnen die Spiele",
    "Der jungen Natur;",
    "Die Zephyre kosen",
    "Und schmeicheln um Rosen,",
    "Und Düfte beströmen die lachende Flur,",
    "Und Düfte beströmen die lachende Flur."
   ]
  },
  {
   "lines_de": [
    "Wie hoch aus den Städten die Rauchwolken dampfen!",
    "Laut wiehern und schnauben und knirschen und strampfen",
    "Die Rosse, die Farren,",
    "Die Wagen erknarren",
    "In's ächzende Thal.",
    "Die Waldungen leben,",
    "Und Adler und Falken und Habichte schweben",
    "Und wiegen die Flügel im blendenden Strahl."
   ]
  },
  {
   "lines_de": [
    "Den Frieden zu finden,",
    "Wohin soll ich wenden",
    "Am wallenden Stab?",
    "Die lachende Erde",
    "Mit Jünglingsgeberde ist",
    "Für mich nur ein Grab."
   ]
  },
  {
   "lines_de": [
    "Steig empor, o Morgenroth, und röthe",
    "Mit purpurnem Kusse Hain und Feld!",
    "Säusle nieder, o Abendroth, und flöte",
    "Sanft sanften Schlummer die todte Welt!",
    "Morgen, ach du röthest",
    "Eine Todtenflur,",
    "Ach und du Abendroth umflötest",
    "Meinen langen Schlummer nur."
   ]
  }
 ],
 "poet_de": "Friedrich Schiller"
}