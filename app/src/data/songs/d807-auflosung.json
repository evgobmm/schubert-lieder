 "stanzas": [
  {
   "lines_de": [
    "Verbirg dich, Sonne,",
    "denn die Gluthen der Wonne",
    "versengen mein Gebein;",
    "verstummet Töne,",
    "Frühlings Schöne",
    "flüchte dich, und lass mich allein,",
    "lass mich allein!"
   ]
  },
  {
   "lines_de": [
    "Quillen doch aus allen Falten",
    "meiner Seele liebliche Gewalten,",
    "aus allen Falten",
    "meiner Seele liebliche Gewalten;",
    "die mich umschlingen,",
    "himmlisch singen,",
    "himmlisch singen"
   ]
  },
