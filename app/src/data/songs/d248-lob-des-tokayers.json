{
 "d": "248",
 "title_de": "Lob des Tokayers",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "O köstlicher Tokayer,",
    "O königlicher Wein,",
    "Du stimmest meine Leier zu",
    "Selt'nen Reimen rein.",
    "Mit lang entbehrter Wonne",
    "Und neu erwachtem Scherz",
    "Erwärmst du gleich der Sonne",
    "Mein halb erstorbnes Herz.",
    "Du stimmest meine Leier zu",
    "Selt'nen Reimen rein,",
    "O köstlicher Tokayer,",
    "O königlicher Wein!"
   ]
  },
  {
   "lines_de": [
    "O köstlicher Tokayer,",
    "O königlicher Wein,",
    "Du giessest Kraft und Feuer",
    "Durch Mark und durch Gebein.",
    "Ich fühle neues Leben",
    "Durch meine Adern sprühn,",
    "Und deine Nektarreben",
    "In meinem Busen glühn.",
    "Du giessest Kraft und Feuer",
    "Durch Mark und durch Gebein,",
    "O köstlicher Tokayer,",
    "O königlicher Wein!"
   ]
  },
  {
   "lines_de": [
    "O köstlicher",
    "Tokayer, dir",
    "Soll als Gramzerstreuer",
    "Dies Lied geweihet sein.",
    "In schwermuthsvollen Launen",
    "Beflügelst du das Blut,",
    "Bei Blonden und bei Braunen",
    "Giebst du dem Blödsinn Muth.",
    "Dir soll als Gramzerstreuer",
    "Dies Lied geweihet sein,",
    "O köstlicher Tokayer,",
    "O königlicher Wein!"
   ]
  }
 ],
 "poet_de": "Gabriele Batsányi"
}