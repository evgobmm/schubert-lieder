{
 "d": "42",
 "title_de": "Misero pargoletto",
 "year": "1813",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Misero pargoletto,",
    "Il tuo destin non sai:",
    "Ah, non gli dite mai",
    "Qual era il genitor."
   ]
  },
  {
   "lines_de": [
    "Come in un punto, oh Dio,",
    "Tutto cangiò d'aspetto:",
    "Voi foste il mio diletto,",
    "Voi siete il mio terror."
   ]
  }
 ],
 "poet_de": "Pietro Metastasio"
}