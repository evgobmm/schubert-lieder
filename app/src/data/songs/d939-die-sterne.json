{
 "d": "939",
 "title_de": "Die Sterne",
 "year": "1828",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wie blitzen",
    "Die Sterne",
    "So hell durch die Nacht!",
    "Bin oft schon",
    "Darüber",
    "Vom Schlummer erwacht."
   ]
  },
  {
   "lines_de": [
    "Doch schelt’ ich",
    "Die lichten",
    "Gebilde d’rum nicht,",
    "Sie üben im Stillen manch’ heilsame Pflicht,",
    "Sie üben",
    "Im Stillen",
    "Manch’ heilsame Pflicht."
   ]
  },
  {
   "lines_de": [
    "Sie wallen",
    "Hoch oben",
    "In Engelgestalt,",
    "Sie leuchten",
    "Dem Pilger",
    "Durch Heiden und Wald."
   ]
  },
  {
   "lines_de": [
    "Sie schweben",
    "Als Boten",
    "Der Liebe umher,",
    "Und tragen oft Küsse weit über das Meer,",
    "Und tragen",
    "Oft Küsse",
    "Weit über das Meer."
   ]
  },
  {
   "lines_de": [
    "Sie blicken",
    "Dem Dulder",
    "Recht mild in’s Gesicht,",
    "Und säumen",
    "Die Tränen",
    "Mit silbernem Licht."
   ]
  },
  {
   "lines_de": [
    "Und weisen",
    "Von Gräbern",
    "Gar tröstlich und hold",
    "Uns hinter das Blaue mit Fingern von Gold,",
    "Uns hinter",
    "Das Blaue",
    "Mit Fingern von Gold."
   ]
  },
  {
   "lines_de": [
    "So sei denn",
    "Gesegnet,",
    "Du strahlige Schaar!",
    "Und leuchte",
    "Mir lange",
    "Noch freundlich und klar!"
   ]
  },
  {
   "lines_de": [
    "Und wenn ich",
    "Einst liebe,",
    "Seid hold dem Verein,",
    "Seid hold dem Verein,",
    "Und euer Geflimmer lasst Segen uns sein,",
    "Und euer",
    "Geflimmer",
    "Lasst Segen uns sein!"
   ]
  }
 ],
 "poet_de": "Karl Gottfried von Leitner"
}