 "stanzas": [
  {
   "lines_de": [
    "Das Fischergewerbe",
    "Gibt rüstigen Muth,",
    "Wir haben zum Erbe",
    "Die Güter der Fluth.",
    "Wir graben nicht Schätze,",
    "Wir pflügen kein Feld,",
    "Wir ernten im Netze, wir angeln uns Geld,",
    "Wir ernten im Netze,",
    "Wir angeln uns Geld."
   ]
  },
  {
   "lines_de": [
    "Wir heben die Reusen",
    "Den Schilfbach entlang",
    "Und ruhn bei den Schleusen,",
    "Zu sondern den Fang.",
    "Goldweiden beschatten",
    "Das moosige Dach,",
    "Wir schlummern auf Matten im kühlen Gemach,",
    "Wir schlummern auf Matten",
    "Im kühlen Gemach."
   ]
  },
  {
   "lines_de": [
    "Mit rothen Korallen",
    "Prangt Spiegel und Wand,",
    "Den Estrich der Hallen",
    "Deckt silberner Sand.",
    "Das Gärtchen daneben",
    "Grünt ländlich umzäunt,",
    "Von kreuzenden Stäben mit Baste vereint,",
    "Von kreuzenden Stäben",
    "Mit Baste vereint."
   ]
  },
  {
   "lines_de": [
    "Oft rudern wir ferne im wiegenden Kahn,",
    "Dann blinken die Sterne so freundlich uns an.",
    "Der Mond aus den Höhen, der Mond aus dem Bach,",
    "So schnell wir entflöhen, sie gleiten uns nach,",
    "So schnell wir entflöhen, sie gleiten uns nach."
   ]
  },
  {
   "lines_de": [
    "Im Antlitz der Buben",
    "Lacht muthiger Sinn,",
    "Sie meiden die Stuben",
    "Bei Tagesbeginn.",
    "Sie tauchen und schwimmen",
    "Im eisigen See",
    "Und barfuss erklimmen sie Klippen voll Schnee,",
    "Und barfuss erklimmen",
    "Sie Klippen voll Schnee."
   ]
  },
  {
   "lines_de": [
    "Wir trotzen dem Wetter, das finster uns droht,",
    "Wenn schöpfende Bretter kaum hemmen den Tod.",
    "Wir trotzen auch Wogen auf krachendem Schiff,",
    "In Tiefen gezogen, geschleudert ans Riff,",
    "In Tiefen gezogen, geschleudert ans Riff."
   ]
  },
  {
   "lines_de": [
    "Die Töchter ergetzen",
    "Sich Abends bei Licht,",
    "Wenn alles an Netzen",
    "Und Maschenwerk flicht.",
    "Oft wird mit Gelächter",
    "Durchmustert das Dorf,",
    "Die Mutter als Wächter schürt nickend den Torf,",
    "Die Mutter als Wächter",
    "Schürt nickend den Torf."
   ]
  },
