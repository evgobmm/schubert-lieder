{
 "d": "549",
 "title_de": "Mahomets Gesang",
 "year": "1817",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Seht den Felsenquell,",
    "Wie ein Sternenblick,",
    "Freudehell,",
    "Wie ein Sternenblick!",
    "Über Wolken nährten seine Jugend",
    "Gute Geister",
    "Zwischen Klippen im Gebüsch,",
    "Zwischen Klippen im Gebüsch."
   ]
  },
  {
   "lines_de": [
    "Jünglingfrisch",
    "Tanzt er aus der Wolke nieder,",
    "Jünglingfrisch",
    "Auf die Marmorfelsen nieder,",
    "Jauchzet wieder",
    "Nach dem Himmel,",
    "Jauchzet wieder",
    "Nach dem Himmel,",
    "Nach dem Himmel."
   ]
  },
  {
   "lines_de": [
    "Durch die Gipfelgänge jagt er",
    "Bunten Kieseln nach,",
    "Und mit frühem Führertritt",
    "Reißt er seine Bruderquellen",
    "Mit sich fort."
   ]
  },
  {
   "lines_de": [
    "Drunten in dem Thal,",
    "Unter seinem Fusstritt",
    "Werden Blumen,",
    "Und die Wiese",
    "Lebt von seinem Hauch.",
    "Doch ihn hält kein Schattenthal,",
    "Keine, keine Blumen,",
    "Die ihm seine"
   ]
  },
  {
   "lines_de": [
    "Knie umschlingen,",
    "Ihm mit Liebesaugen schmeicheln —",
    "Nach der Ebne dringt sein Lauf,",
    "Schlangenwandelnd.",
    "Bäche schmiegen",
    "Sich gesellig an.",
    "Nun tritt er in die"
   ]
  },
  {
   "lines_de": [
    "Ebne, silberprangend,",
    "Und die Ebne prangt mit ihm.",
    "Und die Flüsse von der Ebne",
    "Und die Bäche von den Bergen",
    "Jauchzen ihm und rufen: Bruder,",
    "Bruder, nimm die Brüder mit,",
    "Mit zu deinem alten Vater..."
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}