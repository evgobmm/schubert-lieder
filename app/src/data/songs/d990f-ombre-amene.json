{
 "d": "990F",
 "title_de": "Ombre amene",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Ombre amene,",
    "Amiche piante,",
    "Il mio bene,",
    "Il caro Amante.",
    "Chi mi dice ove n’andò?"
   ]
  },
  {
   "lines_de": [
    "Zeffiretto lusinghiero",
    "A lui vola messagiero",
    "Di che torni",
    "E che mi renda",
    "Quella pace che non ho."
   ]
  }
 ]
}