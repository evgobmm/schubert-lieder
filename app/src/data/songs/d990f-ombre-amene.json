{
 "d": "990F",
 "title_de": "Ombre amene",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Ombre amene, amiche piante,",
    "Il mio bene, il caro Amante.",
    "Chi mi dice ove n’andò?",
    "Zeffiretto lusinghiero",
    "A lui vola messagiero",
    "Di che torni",
    "E che mi renda quella pace che non ho."
   ]
  }
 ]
}