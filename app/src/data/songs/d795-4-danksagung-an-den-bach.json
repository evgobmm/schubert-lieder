{
 "d": "795/4",
 "title_de": "Danksagung an den Bach",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "War es also gemeint,",
    "Mein rauschender Freund,",
    "Dein Singen, dein Klingen",
    "War es also gemeint,",
    "War es also gemeint?"
   ]
  },
  {
   "lines_de": [
    "Zur Müllerin hin,",
    "So lautet der Sinn;",
    "Gelt, hab' ich's verstanden,",
    "Hab' ich's verstanden?",
    "Zur Müllerin hin,",
    "Zur Müllerin hin!"
   ]
  },
  {
   "lines_de": [
    "Hat sie dich geschickt,",
    "Oder hast mich berückt?",
    "Das möcht' ich noch wissen,",
    "Ob sie dich geschickt,",
    "Ob sie dich geschickt."
   ]
  },
  {
   "lines_de": [
    "Nun wie's auch mag sein,",
    "Ich gebe mich d'rein;",
    "Was ich such', hab' ich funden,",
    "Wie's immer mag sein."
   ]
  },
  {
   "lines_de": [
    "Nach Arbeit ich frug,",
    "Nun hab' ich genug,",
    "Für die Hände, für's Herze",
    "Vollauf genug,",
    "Vollauf genug."
   ]
  }
 ],
 "poet_de": "Wilhelm Müller"
}