{
 "d": "776",
 "title_de": "Du bist die Ruh",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Du bist die Ruh,",
    "Der Friede mild,",
    "Die Sehnsucht du,",
    "Und was sie stillt."
   ]
  },
  {
   "lines_de": [
    "Ich weihe dir",
    "Voll Lust und Schmerz",
    "Zur Wohnung hier",
    "Mein Aug’ und Herz,",
    "Mein Aug’ und Herz."
   ]
  },
  {
   "lines_de": [
    "Kehr’ ein bei mir,",
    "Und schliesse du",
    "Still hinter dir",
    "Die Pforten zu."
   ]
  },
  {
   "lines_de": [
    "Treib’ andern Schmerz",
    "Aus dieser Brust!",
    "Voll sei dies Herz",
    "Von deiner Lust,",
    "Von deiner Lust."
   ]
  },
  {
   "lines_de": [
    "Dies Augenzelt",
    "Von deinem Glanz",
    "Allein erhellt,",
    "O füll’ es ganz,",
    "O füll’ es ganz!"
   ]
  },
  {
   "lines_de": [
    "Dies Augenzelt",
    "Von deinem Glanz",
    "Allein erhellt,",
    "O füll’ es ganz,",
    "O füll’ es ganz!"
   ]
  }
 ],
 "poet_de": "Friedrich Rückert"
}