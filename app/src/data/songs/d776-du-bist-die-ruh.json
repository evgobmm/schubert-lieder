{
 "d": "776",
 "title_de": "Du bist die Ruh",
 "year": "1823",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Du bist die Ruh,",
    "der Friede mild,",
    "die Sehnsucht du,",
    "und was sie stillt."
   ]
  },
  {
   "lines_de": [
    "Ich weihe dir",
    "voll Lust und Schmerz",
    "zur Wohnung hier",
    "mein Aug’ und Herz,",
    "mein Aug’ und Herz."
   ]
  },
  {
   "lines_de": [
    "Kehr’ ein bei mir,",
    "und schliesse du",
    "still hinter dir",
    "die Pforten zu."
   ]
  },
  {
   "lines_de": [
    "Treib’ andern Schmerz",
    "aus dieser Brust!",
    "Voll sei dies Herz",
    "von deiner Lust,",
    "von deiner Lust."
   ]
  },
  {
   "lines_de": [
    "Dies Augenzelt",
    "von deinem Glanz",
    "allein erhellt,",
    "o füll’ es ganz,",
    "o füll’ es ganz!"
   ]
  },
  {
   "lines_de": [
    "Dies Augenzelt",
    "von deinem Glanz",
    "allein erhellt,",
    "o füll’ es ganz,",
    "o füll’ es ganz!"
   ]
  }
 ],
 "poet_de": "Friedrich Rückert"
}