{
 "d": "247",
 "title_de": "Die Spinnerin",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Als ich still und ruhig spann,",
    "Ohne nur zu stocken,",
    "Trat ein schöner junger Mann",
    "Nahe mir zum Schrecken."
   ]
  },
  {
   "lines_de": [
    "Lobte, was zu loben war:",
    "Sollte das was schaden?",
    "Meinem Flachse gleiches Haar,",
    "Und den gleichen Faden."
   ]
  },
  {
   "lines_de": [
    "Ruhig war er nicht dabei,",
    "Liess es nicht beim Alten;",
    "Und der Faden riss entzwei,",
    "Den ich lang erhalten."
   ]
  },
  {
   "lines_de": [
    "Und des Flachses Steingewicht",
    "Gab noch viele Zahlen;",
    "Aber ach, ich konnte nicht",
    "Mehr mit ihnen prahlen."
   ]
  },
  {
   "lines_de": [
    "Als ich sie zum Weber trug,",
    "Fühlt' ich was sich regen,",
    "Und mein armes Herze schlug",
    "Mit geschwindern Schlägen."
   ]
  },
  {
   "lines_de": [
    "Nun, beim heissen Sonnenstich,",
    "Bring ich's auf die Bleiche,",
    "Und mit Mühe bück ich mich",
    "Nach dem nächsten Teiche."
   ]
  },
  {
   "lines_de": [
    "Was ich in dem Kämmerlein",
    "Still und fein gesponnen,",
    "Kommt, wie kann es anders sein,",
    "Endlich an die Sonnen."
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}