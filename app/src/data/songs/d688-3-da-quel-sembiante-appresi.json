{
 "d": "688/3",
 "title_de": "Da quel sembiante appresi",
 "year": "1820",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Da quel sembiante appresi",
    "A sospirand'amore,",
    "Face cui m'accesi,",
    "Solo m'alletta e piace."
   ]
  },
  {
   "lines_de": [
    "Da quel sembiante appresi",
    "A sospirand'amore,",
    "Solo m'alletta e piace,",
    "è Fredda ogn'altra face",
    "Per riscaldarmi il cuore."
   ]
  },
  {
   "lines_de": [
    "Per quel sembiante",
    "Sospirerò d'amore sempre,",
    "Per quel sembiante",
    "Sospirerò per riscaldarmi il cuore,",
    "è Fredda ogn'altra face",
    "Per riscaldarmi il cuore."
   ]
  },
  {
   "lines_de": [
    "Amore... cuore."
   ]
  }
 ],
 "poet_de": "Pietro Metastasio, Jacopo Vittorelli"
}