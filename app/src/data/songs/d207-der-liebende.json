{
 "d": "207",
 "title_de": "Der Liebende",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Beglückt, beglückt,",
    "Wer dich erblickt",
    "Und deinen Himmel trinket,",
    "Wenn dein Gesicht",
    "Voll Engellicht",
    "Den Gruss des Friedens winket,",
    "Wer dich erblickt, beglückt."
   ]
  },
  {
   "lines_de": [
    "Ein süsser Blick,",
    "Ein Wink, ein Nick",
    "Glänzt mir wie Frühlingssonnen,",
    "Den ganzen Tag",
    "Sinn ich ihm nach",
    "Und schweb in Himmelswonnen."
   ]
  },
  {
   "lines_de": [
    "Dein holdes Bild",
    "Führt mich so mild",
    "An sanfter Blumenkette,",
    "In meinem Arm",
    "Erwacht es warm",
    "Und geht mit mir zu Bette."
   ]
  },
  {
   "lines_de": [
    "Beglückt, beglückt,",
    "Wer dich erblickt",
    "Und deinen Himmel trinket,",
    "Wem süsser Blick",
    "Und Wink und Nick",
    "Zum süssern Kusse winket."
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
}