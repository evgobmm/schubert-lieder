{
 "d": "207",
 "title_de": "Der Liebende",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Beglückt, beglückt, wer dich erblickt",
    "Und deinen Himmel trinket,",
    "Wenn dein Gesicht voll Engellicht",
    "Den Gruss des Friedens winket,",
    "Wer dich erblickt, beglückt."
   ]
  },
  {
   "lines_de": [
    "Ein süsser Blick, ein Wink, ein Nick",
    "Glänzt mir wie Frühlingssonnen,",
    "Den ganzen Tag sinn ich ihm nach",
    "Und schweb in Himmelswonnen."
   ]
  },
  {
   "lines_de": [
    "Dein holdes Bild führt mich so mild",
    "An sanfter Blumenkette,",
    "In meinem Arm erwacht es warm",
    "Und geht mit mir zu Bette."
   ]
  },
  {
   "lines_de": [
    "Beglückt, beglückt, wer dich erblickt",
    "Und deinen Himmel trinket,",
    "Wem süsser Blick und Wink und Nick",
    "Zum süssern Kusse winket."
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
}