{
 "d": "126",
 "title_de": "Szene aus \"Faust\"",
 "year": "1814",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Wie anders, Gretchen, war dir's,",
    "Als du noch voll Unschuld",
    "Hier zum Altar tratst,",
    "Aus dem vergriffnen Büchelchen",
    "Gebete lalltest,",
    "Halb Kinderspiele,",
    "Halb Gott im Herzen!",
    "Gretchen!",
    "Wo steht dein Kopf?",
    "In deinem Herzen",
    "Welche Missethat?"
   ]
  },
  {
   "lines_de": [
    "Bet'st du für deiner Mutter Seele, die",
    "Durch dich zur langen, langen Pein hinüberschlief?",
    "Auf deiner Schwelle wessen Blut?",
    "Und unter deinem Herzen",
    "Regt sich's nicht quillend schon",
    "Und ängstigt dich und sich",
    "Mit ahnungsvoller Gegenwart?"
   ]
  },
  {
   "lines_de": [
    "Weh! weh!",
    "Wär ich der Gedanken los,",
    "Die mir herüber und hinüber gehen",
    "Wider mich!"
   ]
  },
  {
   "lines_de": [
    "Dies irae, dies illa",
    "Solvet saeclum in favilla."
   ]
  },
  {
   "lines_de": [
    "Grimm fasst dich!",
    "Die Posaune tönt!",
    "Die Gräber beben!",
    "Und dein Herz",
    "Aus Aschenruh",
    "Zu Flammenqualen",
    "Wieder aufgeschaffen,",
    "Bebt auf!"
   ]
  },
  {
   "lines_de": [
    "Wär ich hier weg!",
    "Mir ist, als ob die Orgel mir",
    "Den Athem versetzte,",
    "Gesang mein Herz",
    "Im Tiefsten löste."
   ]
  },
  {
   "lines_de": [
    "Judex ergo cum sedebit,",
    "Quidquid latet, adparebit,",
    "Nil inultum remanebit."
   ]
  },
  {
   "lines_de": [
    "Mir wird so eng!",
    "Die Mauerpfeiler",
    "Befangen mich!",
    "Das Gewölbe",
    "Drängt mich! Luft! Luft!"
   ]
  },
  {
   "lines_de": [
    "Verbirg dich! Sünd' und Schande",
    "Bleibt nicht verborgen.",
    "Luft? Licht?",
    "Wehe dir!"
   ]
  },
  {
   "lines_de": [
    "Quid sum miser tunc dicturus?",
    "Quem patronum rogaturus,",
    "Cum vix justus, cum vix justus sit securus?"
   ]
  },
  {
   "lines_de": [
    "Ihr Antlitz wenden",
    "Verklärte von dir ab.",
    "Die Hände dir zu reichen",
    "Schauert's den Reinen.",
    "Weh!"
   ]
  },
  {
   "lines_de": [
    "Quid sum miser tunc dicturus?",
    "Quem patronum rogaturus?"
   ]
  }
 ],
 "poet_de": "Johann Wolfgang von Goethe"
}