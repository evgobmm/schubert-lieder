{
 "d": "99",
 "title_de": "Andenken",
 "year": "1814",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Ich denke dein,",
    "wenn durch den Hain",
    "der Nachtigallen",
    "Accorde schallen!",
    "Wann denkst du mein?"
   ]
  },
  {
   "lines_de": [
    "Ich denke dein",
    "im Dämmerschein",
    "der Abendhelle",
    "am Schattenquelle!",
    "Wo denkst du mein?"
   ]
  },
  {
   "lines_de": [
    "Ich denke dein",
    "mit süsser Pein,",
    "mit bangem Sehnen",
    "und heissen Thränen!",
    "Wie denkst du mein?"
   ]
  },
  {
   "lines_de": [
    "O denke mein,",
    "bis zum Verein",
    "auf besserm Sterne!",
    "In jeder Ferne",
    "denk ich nur dein!"
   ]
  }
 ],
 "poet_de": "Friedrich von Matthisson"
}