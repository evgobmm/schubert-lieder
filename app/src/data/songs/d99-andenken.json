{
 "d": "99",
 "title_de": "Andenken",
 "year": "1814",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Ich denke dein,",
    "Wenn durch den Hain",
    "Der Nachtigallen",
    "Accorde schallen!",
    "Wann denkst du mein?"
   ]
  },
  {
   "lines_de": [
    "Ich denke dein",
    "Im Dämmerschein",
    "Der Abendhelle",
    "Am Schattenquelle!",
    "Wo denkst du mein?"
   ]
  },
  {
   "lines_de": [
    "Ich denke dein",
    "Mit süsser Pein,",
    "Mit bangem Sehnen",
    "Und heissen Thränen!",
    "Wie denkst du mein?"
   ]
  },
  {
   "lines_de": [
    "O denke mein,",
    "Bis zum Verein",
    "Auf besserm Sterne!",
    "In jeder Ferne",
    "Denk ich nur dein!"
   ]
  }
 ],
 "poet_de": "Friedrich von Matthisson"
}