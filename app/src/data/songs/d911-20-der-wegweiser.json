{
 "d": "911/20",
 "title_de": "Der Wegweiser",
 "year": "1827",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Was vermeid' ich denn die Wege,",
    "wo die andern Wandrer gehn,",
    "suche mir versteckte Stege",
    "durch verschneite Felsenhöhn?",
    "suche mir versteckte Stege",
    "durch verschneite Felsenhöhn, durch Felsenhöhn?"
   ]
  },
  {
   "lines_de": [
    "Habe ja doch nichts begangen,",
    "dass ich Menschen sollte scheun,",
    "dass ich Menschen sollte scheun,",
    "welch ein thörichtes Verlangen",
    "treibt mich in die Wüsteneien,",
    "treibt mich in die Wüstenei'n?"
   ]
  },
  {
   "lines_de": [
    "Weiser stehen auf den Straßen,",
    "weisen auf die Städte zu,",
    "und ich wandre sonder Massen,",
    "ohne Ruh, und suche Ruh,",
    "und ich wandre sonder Massen,",
    "ohne Ruh, und suche Ruh,",
    "und suche Ruh."
   ]
  },
  {
   "lines_de": [
    "Einen Weiser seh' ich stehen",
    "unverrückt vor meinem Blick;",
    "eine Strasse muss ich gehen,",
    "eine Strasse muss ich gehen,",
    "die noch keiner ging zurück."
   ]
  },
  {
   "lines_de": [
    "Einen Weiser seh' ich stehen",
    "unverrückt vor meinem Blick;",
    "eine Strasse muss ich gehen,",
    "die noch keiner ging zurück,",
    "die noch keiner ging zurück."
   ]
  }
 ],
 "poet_de": "Wilhelm Müller"
