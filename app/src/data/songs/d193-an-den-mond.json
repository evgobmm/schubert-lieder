{
 "d": "193",
 "title_de": "An den Mond",
 "year": "1815",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Geuss, lieber Mond, geuss deine Silberflimmer",
    "Durch dieses Buchengrün,",
    "Wo Phantasien und Traumgestalten immer",
    "Vor mir vorüber flieh'n!",
    "Enthülle dich,"
   ]
  },
  {
   "lines_de": [
    "Dass ich die Stätte finde,",
    "Wo oft mein Mädchen sass,",
    "Und oft im Weh'n des Buchbaums und der Linde",
    "Der goldnen Stadt vergass!"
   ]
  },
  {
   "lines_de": [
    "Enthülle dich, dass ich des Strauchs mich freue,",
    "Der Kühlung ihr gerauscht,",
    "Und einen Kranz auf jeden Anger streue,",
    "Wo sie den Bach belauscht!"
   ]
  },
  {
   "lines_de": [
    "Dann, lieber Mond, dann nimm den Schleier wieder",
    "Und traur' um deinen Freund,",
    "Und weine durch den Wolkenflor hernieder,",
    "Wie dein Verlassner weint!"
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
}