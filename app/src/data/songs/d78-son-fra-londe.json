{
 "d": "78",
 "title_de": "Son fra l'onde",
 "year": "1813",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Son fra l'onde in mezzo al mare,",
    "Al furor di doppio vento;",
    "Or resisto, or mi sgomento,",
    "Fra la speme, fra l'orror,",
    "Fra la speme, fra l'orror."
   ]
  },
  {
   "lines_de": [
    "Per la fe, per la tua vita,",
    "Or pavento, or son ardita;",
    "Ritrovo egual martire",
    "Nell'ardire, nel timor,",
    "Ritrovo egual martire",
    "Nell'ardire, nel timor."
   ]
  }
 ],
 "poet_de": "Pietro Metastasio"
}