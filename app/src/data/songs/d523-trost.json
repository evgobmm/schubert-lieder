{
 "d": "523",
 "title_de": "Trost",
 "year": "1817",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Nimmer lange weil ich hier,",
    "Komme bald hinauf zu dir!",
    "Komme bald hinauf zu dir —",
    "Schmerzen, Qualen, tief und still",
    "Fühl ich's in mir —",
    "Nimmer, für und für,",
    "Wüthen in den Busen mir!",
    "Komme bald hinauf zu dir!",
    "Nimmer lange weil ich hier,",
    "Komme bald hinauf zu dir!"
   ]
  },
  {
   "lines_de": [
    "Tief und still fühl ich's in mir,",
    "Nimmer lange weil ich hier;",
    "Eines heissen Dranges Gier,",
    "Komme bald hinauf zu dir!"
   ]
  },
  {
   "lines_de": [
    "Zehrt die Flamm im Innern hier,",
    "Tief und still fühl ich's in mir;",
    "Tief und still fühl' ich's in mir,",
    "Nimmer lange weil ich hier!"
   ]
  }
 ],
 "poet_de": "unbekannt"
}