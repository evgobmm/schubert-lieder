{
 "d": "436",
 "title_de": "Klage",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Dein Silber schien durch Eichengrün,",
    "das Kühlung gab,",
    "auf mich herab,",
    "Mond, und lachte Ruh",
    "mir frohem Knaben zu."
   ]
  },
  {
   "lines_de": [
    "Wenn jetzt dein Licht durch's Fenster bricht,",
    "lacht's keine Ruh",
    "mir, Jüngling, zu;",
    "sieht's meine Wange blass,",
    "mein Auge thränen naß.",
    "Bald, lieber Freund, ach bald",
    "bescheint dein Silberschein",
    "den Leichenstein,",
    "der meines Jünglings Asche birgt,",
    "des Jünglings Asche birgt."
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
}