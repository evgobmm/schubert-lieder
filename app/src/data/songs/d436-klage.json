{
 "d": "436",
 "title_de": "Klage",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Dein Silber schien",
    "Durch Eichengrün,",
    "Das Kühlung gab,",
    "Auf mich herab,",
    "Mond, und lachte Ruh",
    "Mir frohem Knaben zu."
   ]
  },
  {
   "lines_de": [
    "Wenn jetzt dein Licht",
    "Durch's Fenster bricht,",
    "Lacht's keine Ruh",
    "Mir, Jüngling, zu;",
    "Sieht's meine",
    "Wange blass,",
    "Mein Auge thränen naß."
   ]
  },
  {
   "lines_de": [
    "Bald, lieber Freund,",
    "Ach bald",
    "Bescheint dein Silberschein",
    "Den Leichenstein,",
    "Der meines Jünglings Asche birgt,",
    "Des Jünglings Asche birgt."
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
}