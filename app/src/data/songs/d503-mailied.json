{
 "d": "503",
 "title_de": "Mailied",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Der Schnee zerrinnt,",
    "Der Mai beginnt,",
    "Die Blüten keimen",
    "Auf Gartenbäumen,",
    "Und Vogelschall",
    "Tönt überall."
   ]
  },
  {
   "lines_de": [
    "Pflückt einen Kranz,",
    "Und haltet Tanz",
    "Auf grünen Auen,",
    "Ihr schönen Frauen,",
    "Wo junge Main",
    "Uns Kühlung streun."
   ]
  },
  {
   "lines_de": [
    "Wer weiss, wie bald",
    "Die Klocke schallt,",
    "Da wir des Maien",
    "Uns nicht mehr freuen:",
    "Wer weiss, wie bald",
    "Die Klocke schallt!"
   ]
  },
  {
   "lines_de": [
    "Drum werdet froh!",
    "Gott will es so,",
    "Der uns dies Leben",
    "Zur Lust gegeben!",
    "Geniesst der Zeit,",
    "Die Gott verleiht!"
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
}