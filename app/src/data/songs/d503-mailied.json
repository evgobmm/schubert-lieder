{
 "d": "503",
 "title_de": "Mailied",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Der Schnee zerrinnt,",
    "der Mai beginnt,",
    "die Blüten keimen",
    "auf Gartenbäumen,",
    "und Vogelschall",
    "tönt überall."
   ]
  },
  {
   "lines_de": [
    "Pflückt einen Kranz,",
    "und haltet Tanz",
    "auf grünen Auen,",
    "ihr schönen Frauen,",
    "wo junge Main",
    "uns Kühlung streun."
   ]
  },
  {
   "lines_de": [
    "Wer weiss, wie bald",
    "die Klocke schallt,",
    "da wir des Maien",
    "uns nicht mehr freuen:",
    "wer weiss, wie bald",
    "die Klocke schallt!"
   ]
  },
  {
   "lines_de": [
    "Drum werdet froh!",
    "Gott will es so,",
    "der uns dies Leben",
    "zur Lust gegeben!",
    "Geniesst der Zeit,",
    "die Gott verleiht!"
   ]
  }
 ],
 "poet_de": "Ludwig Christoph Heinrich Hölty"
}