{
 "d": "475",
 "title_de": "Abschied",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Über die Berge zieht ihr fort,",
    "Kommt an manchen grünen Ort.",
    "Echo! Echo!"
   ]
  },
  {
   "lines_de": [
    "Muss zurücke, ganz allein,",
    "Lebet wohl, es muss so sein!",
    "Echo! Echo!"
   ]
  },
  {
   "lines_de": [
    "Scheiden, meiden, was man liebt,",
    "Ach, wie wird das Herz betrübt,",
    "Wie wird das Herz betrübt?"
   ]
  },
  {
   "lines_de": [
    "O Seelenspiegel, Wald und Hügel,",
    "Schwinden all, hör' verschwimmen",
    "Eurer Stimmen Wiederhall!"
   ]
  },
  {
   "lines_de": [
    "Lebt wohl! klingt klagevoll,",
    "Ach, wie wird das Herz betrübt,",
    "Scheiden, meiden, was man liebt,",
    "Lebt wohl! klingt klagevoll."
   ]
  }
 ],
 "poet_de": "Johann Mayrhofer"
}