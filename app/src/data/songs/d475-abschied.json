{
 "d": "475",
 "title_de": "Abschied",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Über die Berge",
    "Zieht ihr fort,",
    "Kommt an manchen",
    "Grünen Ort.",
    "Echo! Echo!",
    "Muss zurücke,",
    "Ganz allein,",
    "Lebet wohl,",
    "Es muss so sein!",
    "Echo! Echo!",
    "Scheiden,",
    "Meiden,",
    "Was man liebt,",
    "Ach, wie wird",
    "Das Herz betrübt,",
    "Wie wird das Herz betrübt?",
    "O Seelenspiegel,",
    "Wald und Hügel,",
    "Schwinden all,",
    "Hör' verschwimmen",
    "Eurer Stimmen",
    "Wiederhall!",
    "Lebt wohl!",
    "Klingt klagevoll,",
    "Ach, wie wird",
    "Das Herz betrübt,",
    "Scheiden,",
    "Meiden,",
    "Was man liebt,",
    "Lebt wohl! klingt klagevoll."
   ]
  }
 ],
 "poet_de": "Johann Mayrhofer"
}