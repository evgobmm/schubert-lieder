{
 "d": "476",
 "title_de": "Rückweg",
 "year": "1816",
 "text_only": true,
 "source": "OpenScore Lieder Corpus (CC0)",
 "stanzas": [
  {
   "lines_de": [
    "Donaustrom zur Kaiserstadt",
    "geh ich in Bangigkeit,",
    "denn starrt mein Auge thränenfeucht",
    "hin aus in blaue Fern.",
    "Ach was das Leben Schönes hat",
    "entweichet weit und weit,",
    "dorten weilt ich unerreicht",
    "frei unter Freien gern."
   ]
  },
  {
   "lines_de": [
    "Die Berge schwinden allgemach,",
    "mit ihnen Wald und Fluss;",
    "der Kühe Glocken läuten nach",
    "und Hütten nicken Gruss,",
    "der Kühe Glocken läuten nach",
    "und Hütten nicken Gruss."
   ]
  },
  {
   "lines_de": [
    "Wo Liebe noch und Treu gilt,",
    "da öffnet sich das Herz;",
    "die Frucht an ihren Strahlen schwillt",
    "und strebet himmelwärts,",
    "die Frucht an ihren Strahlen schwillt",
    "und strebet himmelwärts."
   ]
  }
 ],
 "poet_de": "Johann Mayrhofer"
}